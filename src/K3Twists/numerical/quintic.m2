-- Exact Euler arithmetic on the subgroup generated by O and O_x.

QuinticNumericalClass = new Type of VarietyNumericalClass

quinticClass = method()
quinticClass(QuinticThreefold, List) := QuinticNumericalClass => (Y, coords) -> (
    if #coords != 2 or not all(coords, i -> instance(i, ZZ)) then error "expected two integral coordinates";
    new QuinticNumericalClass from {"parent" => Y#(symbol quinticModelIdentity), "coordinates" => coords}
    )

eulerPairing(QuinticNumericalClass, QuinticNumericalClass) := ZZ => (v, w) -> (
    if v#"parent" =!= w#"parent" then error "Euler pairing requires the same realized quintic";
    a := v#"coordinates"; b := w#"coordinates";
    a#0 * b#1 - a#1 * b#0
    )

replaceQuinticCoordinates = (v, coords) ->
    new QuinticNumericalClass from {"parent" => v#"parent", "coordinates" => coords}

negateNumerical QuinticNumericalClass := QuinticNumericalClass => v ->
    replaceQuinticCoordinates(v, apply(v#"coordinates", a -> -a))

numericalTwistStep(QuinticNumericalClass, QuinticNumericalClass, ZZ) :=
    QuinticNumericalClass => (v, s, direction) -> (
        coeff := direction * eulerPairing(s, v);
        replaceQuinticCoordinates(v, apply(v#"coordinates", s#"coordinates", (a,b) -> a - coeff*b))
        )

net QuinticNumericalClass := v -> net ("quintic class " | toString v#"coordinates" | " in (O, O_x)")
