-- Bounded additional strategies certified by duality and exact sequences on a smooth quartic.

lineCoordinates = E -> (
    if not E#?"definition" then return null;
    D := E#"definition";
    if D#"kind" === "line_bundle" then return D#"coordinates";
    if D#"kind" =!= "catalogue" then return null;
    K := E#"surface";
    H := K#"polarization"#"coordinates";
    if D#"name" === "O" then return apply(H, i -> 0);
    if D#"name" === "O(1H)" then return H;
    if D#"name" === "O(-1H)" then return apply(H, h -> -h);
    null
    )

unshiftReference = E -> if instance(E, ShiftedK3Object) then (E#"object", E#"shift") else (E, 0)

hyperplaneQuotientReference = K -> (
    L := K#"lattice";
    H := K#"polarization";
    v := mukaiClass(3, divisorClass(L, apply(H#"coordinates", i -> 4*i)), 11);
    newObjectReference(K, hashTable {"kind" => "hyperplane_quotient", "name" => "Q"}, v)
    )

realizedDerived = (E, representative, C, strategy, evidence, fields) -> (
    if numericalClass E =!= numericalClass representative then error "derived realization and reflection disagree";
    if not isWellDefined C then error "invalid realized complex";
    new TwistRealization from merge(hashTable {
        "status" => "realized", "symbolic" => E, "reason" => null, "complex" => C,
        "representative" => representative, "strategy" => strategy,
        "homologicalToCohomological" => "i -> -i", "hypotheses" => evidence
        }, fields, (a,b) -> b)
    )

degreeZeroCone = (f, shift) -> (
    F := complex source f;
    G := complex target f;
    u := map(G, F, i -> f);
    C := if shift == 0 then cone u else complex({if shift % 2 == 0 then f else -f}, Base => shift);
    (u, C)
    )

quarticCoevaluation = (E, input, shift) -> (
    K := E#"surface";
    X := K#"variety";
    R := K#"ring";
    H := (OO_X^1)(1);
    if cohomologyDims H =!= {4, 0, 0} then error "derived Hom to O(H) must be concentrated in degree zero";
    -- The four coordinates and their dual basis give the two maps in the evaluation sequence.
    f := map(R^{4 : 1}, R^1, transpose vars R);
    (u, C) := degreeZeroCone(f, shift - 1);
    if sheaf HH_shift C != 0 or sheaf HH_(shift - 1) C != quotientBundle K then
        error "coevaluation does not give the hyperplane quotient";
    realizedDerived(E, shiftObject(hyperplaneQuotientReference K, shift - 1), C,
        "quartic-degree-zero-coevaluation", {"smooth quartic K3", "spherical hyperplane line bundle",
            "RHom(O,O(H)) concentrated in degree zero", "dual coordinate basis and quotient sequence"},
        hashTable {"direction" => -1, "chainMap" => u, "coevaluation" => f, "relativeShift" => -1,
            "source" => input, "derivedHomDegrees" => {{0,4}}})
    )

-- RHom(I_x,O) is generated by the ideal inclusion by K3 Serre duality.
quarticPointIdealCoevaluation = (E, shift) -> (
    K := E#"surface";
    R := K#"ring";
    I := module pointIdealSheaf K;
    P := module pointSheaf K;
    inclusion := inducedMap(R^1, I);
    quotient := map(P, R^1, {{1_R}});
    if cohomologyDims sheaf I =!= {0,0,1} or kernel quotient != image inclusion
        or kernel inclusion != 0 or coker quotient != 0 then error "invalid point ideal sequence";
    u := map(complex(R^1, Base => shift), complex(I, Base => shift), hashTable {shift => inclusion});
    Y := (cone u)[1];
    p := map(complex(P, Base => shift-1), Y, hashTable {shift-1 => quotient});
    if not isComplexMorphism p or not acyclicCone p then error "point fibre must resolve the marked point";
    realizedDerived(E, shiftObject(catalogueObject(K, "O_x"), shift-1), Y,
        "quartic-point-ideal-coevaluation",
        {"smooth quartic K3", "certified O generator", "K3 Serre duality and the marked point ideal sequence"},
        hashTable {"direction" => -1, "chainMap" => u, "coevaluation" => inclusion, "projection" => p})
    )

quarticQuotientEvaluation = (E, shift) -> (
    K := E#"surface";
    R := K#"ring";
    Q := quotientBundle K;
    if cohomologyDims(Q(-1)) =!= {4, 0, 0} then error "derived Hom from O(H) must be concentrated in degree zero";
    G := R^{4 : 1};
    f := map(module Q, G, id_G);
    inclusion := map(G, R^1, transpose vars R);
    if f * inclusion != 0 or kernel f != image inclusion then error "quotient evaluation is not exact";
    (u, C) := degreeZeroCone(f, shift);
    realizedDerived(E, shiftObject(structureObject K, shift + 1), C,
        "quartic-quotient-evaluation", {"smooth quartic K3", "spherical hyperplane line bundle",
            "dual coordinate sequence and K3 Serre duality", "RHom(O(H),Q) concentrated in degree zero"},
        hashTable {"direction" => 1, "chainMap" => u, "evaluation" => f,
            "kernelInclusion" => inclusion, "relativeShift" => 1, "derivedHomDegrees" => {{0,4}}})
    )

quarticHigherEvaluation = (E, input, shift) -> (
    K := E#"surface";
    R := K#"ring";
    kk := K#"field";
    O := structureObject K;
    ext := extObservation(O, input);
    dimensions := apply(3, i -> {i, observedDimension(ext, i)});
    if dimensions =!= {{0,0},{1,0},{2,4}} then error "expected Ext concentrated in degree two";

    -- For this quartic the graded canonical module is R. Graded local duality
    -- identifies Ext^2(J,R) with the graded dual of R/J for this vertex ideal J.
    -- The map to H^2(O_X(*)) is dual to R -> R/J, an isomorphism in degrees 0 and 1.
    J := module ideal apply(quarticCoverForms K, x -> x^2);
    aug := resolutionMap(complex J, LengthLimit => 3);
    F := source aug;
    next := Hom(F.dd_3, R^1);
    classes := kernel next / image Hom(F.dd_2, R^1);
    frame := basis(-1, classes);
    trace := basis(0, classes);
    if numColumns frame != 4 or numColumns trace != 1 then error "unexpected graded Ext basis dimensions";

    -- Multiplication by x_i gives the cup product with its coordinate section.
    -- Use the chosen nonzero class of H^2(O) as the trace generator.
    serrePairing := columns -> matrix(kk, apply(gens R, x -> (
        row := (x * columns) // trace;
        if trace * row != x * columns then error "could not express the cup product in the trace basis";
        first entries sub(row, kk)
        )));
    pairing := serrePairing frame;
    if rank pairing != 4 then error "the coordinate sections do not give a perfect pairing";
    dualFrame := frame * map(source frame, source frame, sub(pairing^(-1), R));
    pairing = serrePairing dualFrame;
    if pairing != id_(kk^4) then error "the evaluation classes are not Serre dual to the coordinates";

    lifts := map(source next, source dualFrame, ambient dualFrame);
    evaluations := apply(4, i -> homomorphism(lifts_i));
    truncated := complex(canonicalTruncation(F, 0, 2), Base => -2);
    D := directSum toList(4 : truncated);
    L := R^{-1};
    f := map(L, D_0, fold((a,b) -> a | b, evaluations));
    if not isHomogeneous f or not isWellDefined f then
        error "degree-two evaluation must preserve the grading and descend to the finite model";
    u := map(complex L, D, hashTable {0 => f}, Degree => 0);
    C := cone u;

    oneAugmentation := map(complex(R^1, Base => -2), truncated,
        hashTable {-2 => inducedMap(R^1, J) * aug_0}, Degree => 0);
    if not isIsomorphism sheaf homology(-2, oneAugmentation)
        or not all({-1,0}, i -> HH_i truncated == 0) then
        error "the finite model does not resolve O in degree two";
    augmentation := directSum toList(4 : oneAugmentation);

    -- The cone triangle gives O(-H) in degree zero and O^4 in degree one.
    v := mukaiClass input;
    coneClass := mukaiClass(v#"rank" - 4, v#"divisor", v#"eulerComponent" - 4);
    representative := objectReference(K, "T_O(O(-H))", coneClass);
    realizedDerived(E, shiftObject(representative, shift), C[-shift],
        "quartic-degree-two-evaluation", {"smooth quartic K3", "certified O generator",
            "graded local duality at the irrelevant ideal", "Serre-dual coordinate evaluation"},
        hashTable {"direction" => 1, "shift" => shift, "chainMap" => u, "evaluation" => f,
            "derivedHomDegrees" => {{2,4}}, "extDimensions" => dimensions, "serrePairing" => pairing,
            "sourceAugmentation" => augmentation, "traceCocycle" => homomorphism map(source next, source trace, ambient trace)})
    )

requireQuarticForwardMaps = (K, u, aug) -> (
    R := K#"ring";
    D := source u;
    (dlo, dhi) := concentration D;
    if target u != complex R^{-1} or source aug != D or target aug != complex(R^4, Base => -2)
        or not isComplexMorphism u or not isComplexMorphism aug or not isIsomorphism sheaf homology(-2, aug)
        or not all(dlo..dhi, i -> i == -2 or sheaf HH_i D == 0) then
        error "expected the quartic evaluation and its sheaf quasi-isomorphic augmentation";
    )

quarticInverseComparison = (K, C, u, aug, shift) -> (
    requireQuarticForwardMaps(K, u, aug);
    R := K#"ring";
    D := source u;
    coevaluation := (aug[-1] * canonicalMap(D[-1], C))[-shift];
    inclusion := (canonicalMap(C, target u))[-shift];
    if not isComplexMorphism coevaluation or coevaluation * inclusion != 0 then
        error "the coevaluation must be a chain map and kill the line-bundle inclusion";

    -- The forward evaluation triangle gives H^3(C) = H^2(O)^4 as its only
    -- hypercohomology. Restrict the four components to the lowest term of C.
    -- By Serre duality the computed dual-section rank is the rank of their
    -- pairings on H^2 of that term, which maps to H^3(C).
    pairingRank := rank part(0, Hom(coevaluation_(shift-1), R^1));
    if pairingRank != 4 then error "inverse coevaluation must give four independent Serre functionals";

    B := (cone coevaluation)[1];
    L := source inclusion;
    comparison := map(B, L, hashTable {shift => map(B_shift, L_shift, inclusion_shift)}, Degree => 0);
    (lo, hi) := concentration B;
    if not isComplexMorphism comparison or not isIsomorphism sheaf homology(shift, comparison)
        or not all(lo..hi, i -> i == shift or sheaf HH_i B == 0) then
        error "the inverse comparison must be a sheaf quasi-isomorphism with the line bundle";
    (B, coevaluation, comparison, pairingRank)
    )

quarticInverseCancellation = (E, input, shift) -> (
    forward := realizeTwistImage E#"prefix";
    u := forward#"chainMap";
    C := if shift == 0 then forward#"complex" else cone u;
    (B, coevaluation, comparison, pairingRank) :=
        quarticInverseComparison(E#"surface", C, u, forward#"sourceAugmentation", shift);
    realizedDerived(E, shiftObject(input, shift), B, "quartic-degree-two-inverse-cancellation",
        {"certified O generator", "rank-four Serre pairing for the coevaluation",
            "termwise cone projection and sheaf-quasi-isomorphic augmentation"},
        hashTable {"directions" => {1,-1}, "shift" => shift, "chainMap" => coevaluation,
            "comparison" => comparison, "serrePairingRank" => pairingRank, "forward" => forward,
            "derivedHomDegrees" => {{shift - 1,4}}})
    )

quarticSecondForwardEvaluation = (E, input, shift, forward) -> (
    K := E#"surface";
    R := K#"ring";
    firstEvaluation := forward#"chainMap";
    firstAugmentation := forward#"sourceAugmentation";
    requireQuarticForwardMaps(K, firstEvaluation, firstAugmentation);
    C := if shift == 0 then forward#"complex" else cone firstEvaluation;

    -- The same acyclic Koszul cover used for derived global sections also
    -- represents O after sheafification. Lift a basis modulo coboundaries
    -- from its degree-zero Hom strand to graded maps of complexes.
    (cover, augmentationMatrix) := quarticSectionsCover(K, C);
    H := Hom(cover, C);
    (sections, strands) := quarticSectionStrands H;
    (slo, shi) := concentration sections;
    dimensions := select(apply(toList(slo..shi),
        i -> {-i, rank HH_i sections}), row -> row#1 != 0);
    if dimensions =!= {{3,4}} then error "expected four classes in hypercohomological degree three";
    classes := HH_(-3) sections;
    basisModule := prune classes;
    frame := ambient basisModule.cache.pruningMap;
    basisRank := numColumns frame;
    if basisRank != 4 then error "expected a basis modulo the coboundaries";
    cochains := strands#(-3) * sub(frame, R);
    if (H.dd)_(-3) * cochains != 0 then error "the evaluation classes must be cocycles";
    shiftedCover := cover[3];
    components' := apply(4, j -> (
        f := homomorphism(-3, cochains_{j}, H);
        map(C, shiftedCover, i -> f_(i+3))
        ));
    D := directSum toList(4 : shiftedCover);
    u := map(C, D, {components'});
    if not isComplexMorphism u or not isHomogeneous u then error "invalid degree-three evaluation";
    scan(4, j -> (
        component := u * D_[j];
        f := map(C, cover, i -> component_(i-3), Degree => -3);
        if (homomorphism' f)_0 != cochains_{j} then error "the evaluation must represent the chosen cocycles"
        ));

    aug := map(complex(R^1, Base => -3), shiftedCover, hashTable {-3 => augmentationMatrix});
    sourceAugmentation := directSum toList(4 : aug);
    B := cone u;
    (lo, hi) := concentration B;
    fromLine := canonicalMap(B, C) * canonicalMap(C, target firstEvaluation);
    firstProjection := firstAugmentation[-1] * canonicalMap((source firstEvaluation)[-1], C);
    secondProjection := sourceAugmentation[-1] * canonicalMap((source u)[-1], B);
    if not isIsomorphism sheaf homology(0, fromLine)
        or not isIsomorphism sheaf homology(-1, firstProjection)
        or not isIsomorphism sheaf homology(-1, canonicalMap(B, C))
        or not isIsomorphism sheaf homology(-2, secondProjection)
        or not all(lo..hi, i -> member(i, {-2,-1,0}) or sheaf HH_i B == 0) then
        error "unexpected sheaf homology of the second twist";
    (dlo, dhi) := concentration source u;
    if not isIsomorphism sheaf homology(-3, sourceAugmentation)
        or not all(dlo..dhi, i -> i == -3 or sheaf HH_i (source u) == 0) then
        error "the Koszul cover must resolve O in degree three on the quartic";

    realizedDerived(E, shiftObject(input, shift), B[-shift], "quartic-degree-three-evaluation",
        {"certified O generator", "degree-zero Koszul Hom strand", "four degree-three cocycles modulo coboundaries"},
        hashTable {"directions" => {1,1}, "shift" => shift, "chainMap" => u, "forward" => forward,
            "derivedHomDegrees" => dimensions, "sourceAugmentation" => sourceAugmentation,
            "evaluationClassRank" => basisRank,
            "sheafHomologyTypes" => {{-shift,"O(-H)"},{1-shift,"O^4"},{2-shift,"O^4"}}})
    )

quarticMixedPointInverse = (E, C) -> (
    K := E#"surface";
    R := K#"ring";
    H := R^{1};
    G := R^{4:1};
    Iref := catalogueObject(K, "I_x");
    Href := lineBundleObject(K, K#"polarization");
    if ring C =!= R or concentration C =!= (0,1) or C_1 != R^1
        or C_0 != module pointSheaf K or not isWellDefined C or sheaf HH_0 C != 0 then
        error "expected the marked point evaluation cone";
    I := kernel (C.dd)_1;
    if I != module pointIdealSheaf K then error "point cone has the wrong evaluation kernel";
    pointComparison := map(C, complex(I, Base => 1), hashTable {1 => inducedMap(C_1, I)});
    if not isComplexMorphism pointComparison or not isIsomorphism sheaf homology(1, pointComparison) then
        error "the point ideal in degree -1 must resolve the saved cone after sheafification";

    dimensions := extDims(sheaf I, sheaf H);
    if dimensions =!= {4,1,0} then error "unexpected derived Hom from the point ideal to O(H)";
    resolution := resolutionMap(complex I, LengthLimit => 2);
    F := source resolution;
    -- Hom into O(H) sends these free terms to positive twists, which
    -- have no higher cohomology on the quartic. Their degree-zero Hom
    -- strand therefore computes the sheaf Ext classes in degrees 0 and 1.
    if not all(0..2, i -> isFreeModule F_i and all(degrees F_i, d -> first d >= 0)) then
        error "expected acyclic Hom terms for the point ideal resolution";
    -- Retain the first syzygies modulo the incoming boundaries so the
    -- degree-one coevaluation descends on a bounded model of I.
    D := complex(canonicalTruncation(F, 0, 1), Base => 0);
    eps := map(complex I, D, hashTable {0 => resolution_0});
    if not isComplexMorphism eps or not isIsomorphism sheaf homology(0, eps) or HH_1 D != 0 then
        error "invalid finite model of the point ideal";

    toRing := inducedMap(R^1, I);
    coordinateCoevaluation := map(G, R^1, transpose vars R) * toRing;
    previous := Hom(F.dd_1, H);
    next := Hom(F.dd_2, H);
    coordinates := fold((a,b) -> a | b, apply(gens R, x ->
        homomorphism' map(H, F_0, x * toRing * resolution_0)));
    if previous * coordinates != 0 or numColumns basis(0, image coordinates) != dimensions#0 then
        error "the coordinate coevaluation does not give a basis in degree zero";
    frame := basis(0, kernel next / image previous);
    if numColumns frame != dimensions#1 then error "expected one degree-one class modulo coboundaries";
    lift' := map(source next, source frame, ambient frame);
    higher := map(H, D_1, homomorphism lift'_0);
    cocycle := homomorphism' map(H, F_1, higher);
    if not isHomogeneous higher or not isWellDefined higher or next * cocycle != 0
        or previous * (cocycle // previous) == cocycle then
        error "the degree-one coevaluation must descend and represent a nonzero Ext class";

    u0 := map(complex G, D, hashTable {0 => coordinateCoevaluation * resolution_0});
    u1 := map(complex(H, Base => 1), D, hashTable {1 => higher});
    unshifted := u0 || u1;
    u := unshifted[-1];
    if not isComplexMorphism u or not isHomogeneous u then error "invalid shifted coevaluation";
    sourceComparison := map(C, source u, hashTable {1 => pointComparison_1 * eps_0});
    if not isComplexMorphism sourceComparison or not isIsomorphism sheaf homology(1, sourceComparison) then
        error "invalid comparison to the forward cone";

    -- The inverse takes the cone of the coevaluation and shifts it by [-1]
    -- cohomologically, cancelling the shift of I_x[1].
    inverseCone := cone u;
    B := inverseCone[1];
    includeH := (canonicalMap(inverseCone, target u) * (((target unshifted)_[1])[-1]))[1];
    Q := coker coordinateCoevaluation;
    projectQ := map(complex Q, B, hashTable {0 => map(Q, B_0, inducedMap(Q, G))});
    if concentration B =!= (0,2) or not isComplexMorphism projectQ or not isComplexMorphism includeH
        or not isIsomorphism sheaf homology(0, projectQ) or not isIsomorphism sheaf homology(1, includeH)
        or sheaf HH_2 B != 0 then error "unexpected sheaf homology of the mixed point twist";

    -- The two homology sheaves give [Q] - [O(H)] = 3[O(H)] - [I_x].
    (hr, hc, hs) := classCoordinates mukaiClass Href;
    (ir, ic, is') := classCoordinates mukaiClass Iref;
    v := mukaiClass(3*hr-ir, divisorClass(K#"lattice", apply(hc, ic, (h,i) -> 3*h-i)), 3*hs-is');
    representative := objectReference(K, "T_{O(H)}^-1(T_O(O_x))", v);
    realizedDerived(E, representative, B, "quartic-point-inverse-coevaluation",
        {"smooth quartic K3", "point evaluation with kernel I_x",
            "coordinate sections and the nonzero degree-one Ext class modulo coboundaries"},
        hashTable {"directions" => {1,-1}, "forwardShift" => 1, "chainMap" => u,
            "sourceAugmentation" => sourceComparison, "pointComparison" => pointComparison,
            "inclusion" => includeH, "projection" => projectQ,
            "derivedHomDegrees" => {{0,4},{1,1}},
            "sheafHomologyTypes" => {{-1,"O(H)"},{0,"coker(I_x -> O(H)^4)"}}})
    )

-- Split the identity summand in the derived category. This comparison is independent of a lift
-- of the degree-two class. The surviving one-term complex represents the actual cone.
quarticSelfEvaluation = E -> (
    K := E#"surface";
    (input, startShift) := unshiftReference E#"start";
    D := lineCoordinates input;
    H := K#"polarization"#"coordinates";
    if D =!= H and D =!= apply(H, i -> 0) then return null;
    steps := {};
    cursor := E;
    while instance(cursor, SymbolicTwistImage) do (
        signedStep := cursor#"step";
        if not certifiedStep signedStep or lineCoordinates stepObject signedStep =!= D then return null;
        steps = prepend(signedStep#"direction", steps);
        cursor = cursor#"prefix";
        );
    shift := startShift - sum steps;
    X := K#"variety";
    if cohomologyDims (OO_X^1) =!= {1,0,1} then error "unexpected spherical self-Ext for a line bundle";
    R := K#"ring";
    M := if D === H then R^{1} else R^1;
    C := complex({M}, Base => shift);
    realizedDerived(E, shiftObject(input, shift), C,
        "quartic-spherical-self-split", {"smooth quartic K3", "spherical line bundle O or O(H)",
            "RHom(S,S) from RΓ(O)", "Serre trace in degree two", "identity summand split in the derived category"},
        hashTable {"directions" => steps, "shift" => shift, "derivedHomDegrees" => {{0,1},{2,1}},
            "comparison" => "triangular change of basis eliminates the degree-two off-diagonal component"})
    )

realizeQuarticDerived = E -> (
    self := quarticSelfEvaluation E;
    if self =!= null then return self;
    signedStep := E#"step";
    K := E#"surface";
    H := K#"polarization"#"coordinates";
    if not certifiedStep signedStep then return null;
    generator := lineCoordinates stepObject signedStep;
    (input, shift) := unshiftReference E#"start";
    D := lineCoordinates input;
    zero := apply(H, i -> 0);
    negativeHyperplane := apply(H, h -> -h);
    if E#"length" == 2 then (
        firstStep := E#"prefix"#"step";
        if firstStep#"direction" == 1 and certifiedStep firstStep and lineCoordinates stepObject firstStep === zero then (
            if generator === zero and D === negativeHyperplane then
                return (if signedStep#"direction" == 1 then
                    quarticSecondForwardEvaluation(E, input, shift, realizeTwistImage E#"prefix")
                    else quarticInverseCancellation(E, input, shift));
            if signedStep#"direction" == -1 and generator === H and shift == 0
                and input === catalogueObject(K, "O_x") then
                return quarticMixedPointInverse(E, (realizeTwistImage E#"prefix")#"complex");
            );
        );
    if E#"length" != 1 then return null;
    if signedStep#"direction" == -1 and generator === zero and input === catalogueObject(K, "I_x") then
        return quarticPointIdealCoevaluation(E, shift);
    if signedStep#"direction" == 1 and generator === zero and D === negativeHyperplane then
        return quarticHigherEvaluation(E, input, shift);
    if generator =!= H then return null;
    if signedStep#"direction" == -1 and D === zero then
        return quarticCoevaluation(E, input, shift);
    if signedStep#"direction" == 1 and input === hyperplaneQuotientReference K then
        return quarticQuotientEvaluation(E, shift);
    null
    )
