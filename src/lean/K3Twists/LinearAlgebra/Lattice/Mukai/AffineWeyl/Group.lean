import K3Twists.LinearAlgebra.Lattice.Mukai.AffineWeyl
import K3Twists.LinearAlgebra.Lattice.Mukai.Reflection
import Mathlib.GroupTheory.Complement
import Mathlib.GroupTheory.SemidirectProduct

/-!
# The affine Weyl group of an exceptional fibre inside `O(Λ)`

For a connected exceptional fibre `F` (`Mukai.FundamentalCycle`) with root lattice
`Q = ⊕ ℤCᵢ`, three subgroups of the automorphisms of the Mukai lattice `Λ = MukaiLattice ℤ N`:

* the **affine Weyl group** `W_aff = ⟨ρ_{(0, c, s)} : c ∈ Q, c² = -2, s ∈ ℤ⟩`, generated by the
  reflections in the rank-zero roots of the fibre (`FundamentalCycle.affineWeyl`);
* the **finite Weyl group** `W(R) = ⟨ρ_{(0, c, 0)}⟩` (`FundamentalCycle.finiteWeyl`);
* the **translations** `E(Q) = {⊗𝒪(D) : D ∈ Q}`, with `⊗𝒪(D) = E(pt, (0, -D, 0), D²/2)` the Eichler
  transvection at the point class (`FundamentalCycle.translations`; `D²/2` is an integer on `Q`).

**`W_aff = W(R) ⋉ E(Q)`** inside `O(Λ)`, for symmetric `b`:

* both lie in `W_aff`, and every generator is a product: the pair law `ρ_{a + sδ} ρ_a =
  E(δ, s a, -s²)` at `a = (0, c, 0)` gives `ρ_{(0, c, s)} = ⊗𝒪(-sc) ρ_{(0, c, 0)}`
  (`reflect_eq_tensorLine_reflect`); so `W_aff = E(Q) W(R)` (`exists_mul_eq_of_mem_affineWeyl`);
* `E(Q)` is normal in `W_aff`: a reflection conjugates `⊗𝒪(D)` to `⊗𝒪(ρ_c D)`
  (`reflect_tensorLine_reflect`, from the conjugation law of Eichler transvections);
* `W(R) ∩ E(Q) = 1` by evaluating at `(1, 0, 0)`: `W(R)` fixes it and `⊗𝒪(D)` sends it to
  `(1, D, D²/2)` (`disjoint_finiteWeyl_translations`);
* hence `E(Q)` and `W(R)` are complements in `W_aff` (`isComplement'`), and
  `W_aff ≃* E(Q) ⋊ W(R)` (`affineWeylEquiv`).

Everything lies in the isometries `O(Λ)` (`affineWeyl_le_orthogonalGroup`,
`translations_le_orthogonalGroup`).

**Line bundles.** Every isometric line bundle `⊗𝒪(L)` normalizes `W_aff`:
`⊗𝒪(L) ρ_{(0, c, s)} ⊗𝒪(-L) = ρ_{(0, c, s + c·L)}` (`lineTwists_le_normalizer`, from the
equivariance `g ρ_v g⁻¹ = ρ_{gv}` of reflections, `apply_reflect_symm`). So `W_aff` is normal in
the extended affine Weyl group `W(R) ⋉ E(N)`, generated by `W_aff` and the line bundles
(`extendedAffineWeyl`, `affineWeyl_normal`). On the affine simple roots `⊗𝒪(L)` acts through the
degrees `(Cᵢ·L)` (`tensorLine_affineRoot_some`), trivially exactly when `L ⊥ Cᵢ` for every `i`
(`tensorLine_fixes_affineRoot_iff`). The action of the extended group on the affine root lattice
factors faithfully through `W ⋉ Λ`, and `W_aff` maps onto `W ⋉ Q^∨`, of quotient `Λ/Q^∨`
(`AffineWeyl/Semidirect.lean`: `toDegreeSemidirect`, `apply_affineEmbed`,
`degreeSemidirectRep_injective`, `map_affineWeyl_toDegreeSemidirect`,
`degreeSemidirectQuotientEquiv`). The splitting of the extended group by the stabilizer of the
fundamental alcove is not formalized here.

## References

* M. Eichler, *Quadratische Formen und orthogonale Gruppen*, Springer, 1952.
* V. G. Kac, *Infinite dimensional Lie algebras*, §6.5 (the affine Weyl group as `W ⋉ Q^∨`).
-/

open Matrix

namespace Mukai

variable {N : Type*} [AddCommGroup N]

/-- Automorphisms of the Mukai lattice. -/
local notation "Aut(Λ)" => MukaiLattice ℤ N ≃ₗ[ℤ] MukaiLattice ℤ N

variable (b : N →ₗ[ℤ] N →ₗ[ℤ] ℤ) in
/-- **The orthogonal group `O(Λ)`** of the Mukai lattice. -/
def orthogonalGroup : Subgroup Aut(Λ) where
  carrier := {g | ∀ v w, mukaiForm b (g v) (g w) = mukaiForm b v w}
  one_mem' _ _ := rfl
  mul_mem' {g h} hg hh v w := (hg (h v) (h w)).trans (hh v w)
  inv_mem' {g} hg v w := by
    have h := hg (g⁻¹ v) (g⁻¹ w)
    simp only [LinearEquiv.coe_inv, LinearEquiv.apply_symm_apply] at h ⊢
    exact h.symm

variable {b : N →ₗ[ℤ] N →ₗ[ℤ] ℤ}

theorem mem_orthogonalGroup {g : Aut(Λ)} :
    g ∈ orthogonalGroup b ↔ ∀ v w, mukaiForm b (g v) (g w) = mukaiForm b v w :=
  Iff.rfl

theorem reflectEquiv_mem_orthogonalGroup (hb : ∀ x y, b x y = b y x) (s : MukaiLattice ℤ N)
    (hs : IsSpherical b s) : reflectEquiv b s hs ∈ orthogonalGroup b := fun v w => by
  simpa using pairing_reflect_reflect b hb s hs v w

/-- The reflection in a rank-zero class `(0, c, s)` with `c² = -2`. -/
theorem isSpherical_rankZero {c : N} (hc : b c c = -2) (s : ℤ) :
    IsSpherical b ((0, c, s) : MukaiLattice ℤ N) := by
  simpa [IsSpherical] using hc

/-- **Conjugating a line bundle by a reflection in a rank-zero root.** For `c² = -2` and symmetric
`b`, `ρ_{(0, c, s)} ⊗𝒪(D) ρ_{(0, c, s)} = ⊗𝒪(ρ_c D)` with `ρ_c D = D + (D·c) c`: the conjugation law
`g E(e, x, q) g⁻¹ = E(ge, gx, q)` at `e = δ`, and `E(δ, x + tδ, q) = E(δ, x, q)`. -/
theorem reflect_tensorLine_reflect (hb : ∀ x y, b x y = b y x) {c : N} (hc : b c c = -2)
    (s : ℤ) (D : N) (q : ℤ) (v : MukaiLattice ℤ N) :
    reflect b (0, c, s) (tensorLine b D q (reflect b (0, c, s) v)) =
      tensorLine b (D + b D c • c) q v := by
  have hs := isSpherical_rankZero (b := b) hc s
  set g := reflectEquiv b (0, c, s) hs
  have hg : ∀ u w, mukaiForm b (g u) (g w) = mukaiForm b u w :=
    reflectEquiv_mem_orthogonalGroup hb _ hs
  have key := BilinearForm.conj_eichler (mukaiForm b) g hg corankUnit (0, -D, 0) q
  have hδ : g corankUnit = corankUnit := by
    simp only [g, reflectEquiv_apply]
    exact reflect_of_pairing_eq_zero b (by simp [corankUnit])
  have hx : g ((0, -D, 0) : MukaiLattice ℤ N) =
      (0, -(D + b D c • c), 0) + (-(b D c * s)) • corankUnit := by
    simp only [g, reflectEquiv_apply, reflect_apply]
    ext <;> simp [corankUnit]
    abel
  rw [hδ, hx, BilinearForm.eichler_add_smul, ← tensorLine_eq_eichler, ← tensorLine_eq_eichler]
    at key
  have := LinearMap.congr_fun key v
  simpa [g, LinearEquiv.conj_apply_apply] using this

/-- The reflection `ρ_c D = D + (D·c) c` preserves `D²` when `c² = -2` and `b` is symmetric. -/
theorem self_add_smul_reflect (hb : ∀ x y, b x y = b y x) {c : N} (hc : b c c = -2) (D : N) :
    b (D + b D c • c) (D + b D c • c) = b D D := by
  simp only [map_add, map_zsmul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul, hc,
    hb c D]
  ring

/-- **`⊗𝒪(D)` as an automorphism** of the Mukai lattice, for symmetric `b` and `2q = D²`; its
inverse is `⊗𝒪(-D)`. -/
def tensorLineEquiv (hb : ∀ x y, b x y = b y x) (D : N) {q : ℤ} (hq : 2 * q = b D D) : Aut(Λ) :=
  have h1 : tensorLine b D q * tensorLine b (-D) q = 1 := by
    rw [tensorLine_mul b hb, add_neg_cancel, map_neg, show q + q + -b D D = 0 by omega,
      tensorLine_zero]
  have h2 : tensorLine b (-D) q * tensorLine b D q = 1 := by
    rw [tensorLine_mul b hb, neg_add_cancel, map_neg, LinearMap.neg_apply,
      show q + q + -b D D = 0 by omega, tensorLine_zero]
  LinearEquiv.ofLinearMap (f := tensorLine b D q) (g := tensorLine b (-D) q) h1 h2

@[simp]
theorem tensorLineEquiv_apply (hb : ∀ x y, b x y = b y x) (D : N) {q : ℤ} (hq : 2 * q = b D D)
    (v : MukaiLattice ℤ N) : tensorLineEquiv hb D hq v = tensorLine b D q v :=
  rfl

theorem tensorLineEquiv_mem_orthogonalGroup (hb : ∀ x y, b x y = b y x) (D : N) {q : ℤ}
    (hq : 2 * q = b D D) : tensorLineEquiv hb D hq ∈ orthogonalGroup b := fun v w => by
  simpa using mukaiForm_tensorLine b hb hq v w

/-- **Reflections are equivariant**: for an isometry `g`, `g ρ_v g⁻¹ = ρ_{g v}`. -/
theorem apply_reflect_symm {g : Aut(Λ)} (hg : g ∈ orthogonalGroup b) (v w : MukaiLattice ℤ N) :
    g (reflect b v (g.symm w)) = reflect b (g v) w := by
  have h := hg (g.symm w) v
  simp only [mukaiForm_apply, LinearEquiv.apply_symm_apply] at h
  rw [reflect_apply, reflect_apply, map_add, map_zsmul, LinearEquiv.apply_symm_apply, h]

/-- The isometric line bundles `⊗𝒪(L)`, `2q = L²`, as automorphisms: the group `E(N)`. -/
def lineTwists (b : N →ₗ[ℤ] N →ₗ[ℤ] ℤ) : Subgroup Aut(Λ) :=
  Subgroup.closure {g | ∃ L : N, ∃ q : ℤ, 2 * q = b L L ∧ ∀ v, g v = tensorLine b L q v}

namespace FundamentalCycle

variable {ι : Type*} [Fintype ι] (F : FundamentalCycle b ι)

/-! ### Evenness on the fibre lattice -/

/-- `D²` is even for `D` supported on the fibre: `D² = -dᵀAd` with `A` of diagonal `2`. -/
theorem even_self_of_mem_rootLattice (hb : ∀ x y, b x y = b y x) {D : N}
    (hD : D ∈ F.rootLattice) : Even (b D D) := by
  classical
  obtain ⟨d, rfl⟩ := hD
  rw [combination_apply, LinearMap.BilinForm.apply_sum_smul_self, even_neg]
  exact (LinearMap.BilinForm.wallMatrix_isSymm hb _).even_dotProduct_mulVec
    (fun i => by simp [F.curve_self i]) d

/-- `2 (D²/2) = D²` on the fibre lattice. -/
theorem two_mul_self_div_two (hb : ∀ x y, b x y = b y x) {D : N} (hD : D ∈ F.rootLattice) :
    2 * (b D D / 2) = b D D := by
  obtain ⟨m, hm⟩ := F.even_self_of_mem_rootLattice hb hD
  omega

/-! ### The three groups -/

/-- The reflections `ρ_{(0, c, s)}` in the rank-zero roots of the fibre. -/
def affineReflections : Set Aut(Λ) :=
  {g | ∃ c ∈ F.rootLattice, ∃ s : ℤ, ∃ h : IsSpherical b ((0, c, s) : MukaiLattice ℤ N),
    g = reflectEquiv b (0, c, s) h}

/-- **The affine Weyl group** `W_aff = ⟨ρ_{(0, c, s)} : c ∈ Q, c² = -2, s ∈ ℤ⟩` of the fibre. -/
def affineWeyl : Subgroup Aut(Λ) :=
  Subgroup.closure F.affineReflections

/-- **The finite Weyl group** `W(R) = ⟨ρ_{(0, c, 0)} : c ∈ Q, c² = -2⟩` of the fibre. -/
def finiteWeyl : Subgroup Aut(Λ) :=
  Subgroup.closure {g | ∃ c ∈ F.rootLattice, ∃ h : IsSpherical b ((0, c, 0) : MukaiLattice ℤ N),
    g = reflectEquiv b (0, c, 0) h}

/-- The line bundles supported on the fibre, `⊗𝒪(D)` with `D ∈ Q`, as automorphisms. -/
def translationSet : Set Aut(Λ) :=
  {g | ∃ D ∈ F.rootLattice, ∀ v, g v = tensorLine b D (b D D / 2) v}

/-- **The translations** `E(Q) = {⊗𝒪(D) : D ∈ Q}`, `⊗𝒪(D) = E(pt, (0, -D, 0), D²/2)`. -/
def translations : Subgroup Aut(Λ) :=
  Subgroup.closure F.translationSet

theorem tensorLine_add (hb : ∀ x y, b x y = b y x) {D D' : N} (hD : D ∈ F.rootLattice)
    (hD' : D' ∈ F.rootLattice) (v : MukaiLattice ℤ N) :
    tensorLine b D (b D D / 2) (tensorLine b D' (b D' D' / 2) v) =
      tensorLine b (D + D') (b (D + D') (D + D') / 2) v := by
  rw [← mul_apply_eq_comp, tensorLine_mul b hb]
  congr 2
  obtain ⟨m, hm⟩ := F.even_self_of_mem_rootLattice hb hD
  obtain ⟨m', hm'⟩ := F.even_self_of_mem_rootLattice hb hD'
  have h : b (D + D') (D + D') = b D D + 2 * b D D' + b D' D' := by
    simp only [map_add, LinearMap.add_apply, hb D' D]
    ring
  omega

theorem tensorLine_neg_cancel (hb : ∀ x y, b x y = b y x) {D : N} (hD : D ∈ F.rootLattice)
    (v : MukaiLattice ℤ N) :
    tensorLine b (-D) (b (-D) (-D) / 2) (tensorLine b D (b D D / 2) v) = v := by
  rw [F.tensorLine_add hb (F.rootLattice.neg_mem hD) hD, neg_add_cancel]
  simp

/-- **Membership in `E(Q)`.** For symmetric `b`, the translations are exactly the line bundles
supported on the fibre: the set is already a group. -/
theorem mem_translations_iff (hb : ∀ x y, b x y = b y x) {g : Aut(Λ)} :
    g ∈ F.translations ↔ g ∈ F.translationSet := by
  refine ⟨fun hg => ?_, fun hg => Subgroup.subset_closure hg⟩
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact hx
  | one => exact ⟨0, zero_mem _, fun v => by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨D, hD, hx⟩ := hx
    obtain ⟨D', hD', hy⟩ := hy
    exact ⟨D + D', add_mem hD hD', fun v => by
      rw [mul_apply_eq_comp, hy, hx, F.tensorLine_add hb hD hD']⟩
  | inv x _ hx =>
    obtain ⟨D, hD, hx⟩ := hx
    refine ⟨-D, F.rootLattice.neg_mem hD, fun v => ?_⟩
    obtain ⟨w, rfl⟩ := x.surjective v
    rw [LinearEquiv.coe_inv, LinearEquiv.symm_apply_apply, hx, F.tensorLine_neg_cancel hb hD]

/-! ### Isometries -/

theorem affineWeyl_le_orthogonalGroup (hb : ∀ x y, b x y = b y x) :
    F.affineWeyl ≤ orthogonalGroup b := by
  rw [affineWeyl, Subgroup.closure_le]
  rintro g ⟨c, -, s, h, rfl⟩
  exact reflectEquiv_mem_orthogonalGroup hb _ h

theorem translations_le_orthogonalGroup (hb : ∀ x y, b x y = b y x) :
    F.translations ≤ orthogonalGroup b := by
  rw [translations, Subgroup.closure_le]
  rintro g ⟨D, hD, hg⟩ v w
  simp only [mukaiForm_apply] at *
  rw [hg, hg]
  exact mukaiForm_tensorLine b hb (F.two_mul_self_div_two hb hD) v w

/-! ### `W_aff = E(Q) W(R)` -/

theorem finiteWeyl_le_affineWeyl : F.finiteWeyl ≤ F.affineWeyl := by
  rw [finiteWeyl, affineWeyl]
  refine Subgroup.closure_mono ?_
  rintro g ⟨c, hc, h, rfl⟩
  exact ⟨c, hc, 0, h, rfl⟩

/-- **The pair law on the Mukai lattice.** `ρ_{(0, c, s)} ρ_{(0, c, 0)} = ⊗𝒪(-sc)`, for `c² = -2`:
the pair law `ρ_{a + sδ} ρ_a = E(δ, s a, -s²)` at `a = (0, c, 0)`, `δ = (0, 0, 1)`. -/
theorem reflect_reflect_eq_tensorLine {c : N} (hc : b c c = -2) (s : ℤ) (v : MukaiLattice ℤ N) :
    reflect b (0, c, s) (reflect b (0, c, 0) v) = tensorLine b (-(s • c)) (-s ^ 2) v := by
  have h := BilinearForm.reflectHom_add_smul_mul_reflectHom (mukaiForm b)
    (a := ((0, c, 0) : MukaiLattice ℤ N)) (δ := corankUnit) (by simpa using hc)
    (by simp [corankUnit]) s
  have hv := LinearMap.congr_fun h v
  simp only [mul_apply_eq_comp, BilinearForm.reflectHom_apply] at hv
  have e1 : ((0, c, 0) : MukaiLattice ℤ N) + s • corankUnit = (0, c, s) := by
    ext <;> simp [corankUnit]
  have e2 : s • ((0, c, 0) : MukaiLattice ℤ N) = (0, -(-(s • c)), 0) := by
    ext <;> simp
  rw [e1, e2] at hv
  rw [tensorLine_eq_eichler]
  exact hv

/-- **Every affine reflection is a translation times a finite reflection**:
`ρ_{(0, c, s)} = ⊗𝒪(-sc) ρ_{(0, c, 0)}`. -/
theorem reflect_eq_tensorLine_reflect {c : N} (hc : b c c = -2) (s : ℤ)
    (v : MukaiLattice ℤ N) :
    reflect b (0, c, s) v = tensorLine b (-(s • c)) (-s ^ 2) (reflect b (0, c, 0) v) := by
  rw [← reflect_reflect_eq_tensorLine hc, reflect_reflect b _ (isSpherical_rankZero hc 0)]

theorem neg_sq_eq_self_div_two {c : N} (hc : b c c = -2) (s : ℤ) :
    -s ^ 2 = b (-(s • c)) (-(s • c)) / 2 := by
  have : b (-(s • c)) (-(s • c)) = -2 * s ^ 2 := by
    simp only [map_neg, map_zsmul, LinearMap.neg_apply, LinearMap.smul_apply, smul_eq_mul, hc]
    ring
  rw [this]
  omega

theorem translationSet_reflect {c : N} (hcQ : c ∈ F.rootLattice)
    (hc : b c c = -2) (s : ℤ) :
    reflectEquiv b (0, c, s) (isSpherical_rankZero hc s) *
        (reflectEquiv b (0, c, 0) (isSpherical_rankZero hc 0))⁻¹ ∈ F.translationSet := by
  refine ⟨-(s • c), F.rootLattice.neg_mem (F.rootLattice.smul_mem s hcQ), fun v => ?_⟩
  rw [mul_apply_eq_comp, LinearEquiv.coe_inv, reflectEquiv_symm_apply, reflectEquiv_apply,
    reflect_reflect_eq_tensorLine hc, ← neg_sq_eq_self_div_two hc]

theorem translations_le_affineWeyl (hb : ∀ x y, b x y = b y x) :
    F.translations ≤ F.affineWeyl := by
  have hQ : ∀ {D : N}, D ∈ AddSubgroup.closure (Set.range F.curve) → D ∈ F.rootLattice := by
    intro D hD
    rw [← Submodule.span_int_eq_addSubgroupClosure, Submodule.mem_toAddSubgroup,
      ← Fintype.range_linearCombination] at hD
    exact hD
  -- every line bundle supported on the fibre is realized in `W_aff`
  have hgen : ∀ D ∈ F.rootLattice, ∃ g ∈ F.affineWeyl, ∀ v,
      g v = tensorLine b D (b D D / 2) v := by
    intro D hD
    rw [rootLattice, combination, Fintype.range_linearCombination, ← Submodule.mem_toAddSubgroup,
      Submodule.span_int_eq_addSubgroupClosure] at hD
    induction hD using AddSubgroup.closure_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      have hC := F.curve_self i
      have hCQ : F.curve i ∈ F.rootLattice := by
        classical
        exact ⟨Pi.single i 1, by simp [combination]⟩
      refine ⟨reflectEquiv b (0, F.curve i, -1) (isSpherical_rankZero hC (-1)) *
        (reflectEquiv b (0, F.curve i, 0) (isSpherical_rankZero hC 0))⁻¹,
        mul_mem (Subgroup.subset_closure ⟨_, hCQ, -1, _, rfl⟩)
          (inv_mem (Subgroup.subset_closure ⟨_, hCQ, 0, _, rfl⟩)), fun v => ?_⟩
      rw [mul_apply_eq_comp, LinearEquiv.coe_inv, reflectEquiv_symm_apply, reflectEquiv_apply,
        reflect_reflect_eq_tensorLine hC, hC]
      simp
    | zero => exact ⟨1, one_mem _, fun v => by simp⟩
    | add x y hx hy ihx ihy =>
      obtain ⟨g, hg, hgx⟩ := ihx
      obtain ⟨g', hg', hgy⟩ := ihy
      exact ⟨g * g', mul_mem hg hg', fun v => by
        rw [mul_apply_eq_comp, hgy, hgx, F.tensorLine_add hb (hQ hx) (hQ hy)]⟩
    | neg x hx ihx =>
      obtain ⟨g, hg, hgx⟩ := ihx
      refine ⟨g⁻¹, inv_mem hg, fun v => ?_⟩
      obtain ⟨w, rfl⟩ := g.surjective v
      rw [LinearEquiv.coe_inv, LinearEquiv.symm_apply_apply, hgx,
        F.tensorLine_neg_cancel hb (hQ hx)]
  rw [translations, Subgroup.closure_le]
  rintro g ⟨D, hD, hg⟩
  obtain ⟨g', hg', hg'D⟩ := hgen D hD
  have : g = g' := LinearEquiv.ext fun v => by rw [hg, hg'D]
  exact this ▸ hg'


/-! ### Normality, disjointness and the semidirect product -/

/-- **A reflection in a rank-zero root of the fibre normalizes `E(Q)`.** -/
theorem reflectEquiv_mem_normalizer (hb : ∀ x y, b x y = b y x) {c : N}
    (hcQ : c ∈ F.rootLattice) (hc : b c c = -2) (s : ℤ) :
    reflectEquiv b (0, c, s) (isSpherical_rankZero hc s) ∈
      Subgroup.normalizer (F.translations : Set Aut(Λ)) := by
  set g := reflectEquiv b (0, c, s) (isSpherical_rankZero hc s)
  have conj : ∀ h ∈ F.translations, g * h * g⁻¹ ∈ F.translations := by
    intro h hh
    obtain ⟨D, hD, hhD⟩ := (F.mem_translations_iff hb).mp hh
    refine (F.mem_translations_iff hb).mpr
      ⟨D + b D c • c, add_mem hD (F.rootLattice.smul_mem _ hcQ), fun v => ?_⟩
    rw [mul_apply_eq_comp, mul_apply_eq_comp, LinearEquiv.coe_inv, reflectEquiv_symm_apply, hhD,
      reflectEquiv_apply, reflect_tensorLine_reflect hb hc, self_add_smul_reflect hb hc]
  have hinv : g⁻¹ = g := LinearEquiv.ext fun v => by simp [g]
  rw [Subgroup.mem_normalizer_iff]
  intro h
  refine ⟨conj h, fun hh => ?_⟩
  have key : g⁻¹ * (g * h * g⁻¹) * g = g * (g * h * g⁻¹) * g⁻¹ := by rw [hinv]
  have e : g⁻¹ * (g * h * g⁻¹) * g = h := by group
  rw [← e, key]
  exact conj _ hh

theorem affineWeyl_le_normalizer (hb : ∀ x y, b x y = b y x) :
    F.affineWeyl ≤ Subgroup.normalizer (F.translations : Set Aut(Λ)) := by
  rw [affineWeyl, Subgroup.closure_le]
  rintro g ⟨c, hcQ, s, h, rfl⟩
  exact F.reflectEquiv_mem_normalizer hb hcQ (by simpa [IsSpherical] using h) s

/-- **`E(Q)` is normal in `W_aff`.** -/
theorem translations_normal (hb : ∀ x y, b x y = b y x) :
    (F.translations.subgroupOf F.affineWeyl).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer (F.translations_le_affineWeyl hb)).mpr
    (F.affineWeyl_le_normalizer hb)

/-- **`W_aff = E(Q) W(R)`**: every element of the affine Weyl group is a translation times an
element of the finite Weyl group. -/
theorem exists_mul_eq_of_mem_affineWeyl (hb : ∀ x y, b x y = b y x) {g : Aut(Λ)}
    (hg : g ∈ F.affineWeyl) : ∃ t ∈ F.translations, ∃ w ∈ F.finiteWeyl, t * w = g := by
  have hN : ∀ w ∈ F.finiteWeyl, ∀ t ∈ F.translations, w * t * w⁻¹ ∈ F.translations :=
    fun w hw t ht => (Subgroup.mem_normalizer_iff.mp
      (F.affineWeyl_le_normalizer hb (F.finiteWeyl_le_affineWeyl hw)) t).mp ht
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨c, hcQ, s, h, rfl⟩ := hx
    have hc : b c c = -2 := by simpa [IsSpherical] using h
    exact ⟨_, Subgroup.subset_closure (F.translationSet_reflect hcQ hc s),
      reflectEquiv b (0, c, 0) (isSpherical_rankZero hc 0),
      Subgroup.subset_closure ⟨c, hcQ, _, rfl⟩, by group⟩
  | one => exact ⟨1, one_mem _, 1, one_mem _, mul_one 1⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨t, ht, w, hw, rfl⟩ := ihx
    obtain ⟨t', ht', w', hw', rfl⟩ := ihy
    exact ⟨t * (w * t' * w⁻¹), mul_mem ht (hN w hw t' ht'), w * w', mul_mem hw hw', by group⟩
  | inv x _ ihx =>
    obtain ⟨t, ht, w, hw, rfl⟩ := ihx
    refine ⟨w⁻¹ * t⁻¹ * w⁻¹⁻¹, hN _ (inv_mem hw) _ (inv_mem ht), w⁻¹, inv_mem hw, by group⟩

/-- **`W_aff = E(Q) ⊔ W(R)`.** -/
theorem affineWeyl_eq_sup (hb : ∀ x y, b x y = b y x) :
    F.affineWeyl = F.translations ⊔ F.finiteWeyl := by
  refine le_antisymm (fun g hg => ?_)
    (sup_le (F.translations_le_affineWeyl hb) F.finiteWeyl_le_affineWeyl)
  obtain ⟨t, ht, w, hw, rfl⟩ := F.exists_mul_eq_of_mem_affineWeyl hb hg
  exact mul_mem (Subgroup.mem_sup_left ht) (Subgroup.mem_sup_right hw)

/-- `W(R)` fixes `(1, 0, 0)`. -/
theorem finiteWeyl_apply_rankUnit {g : Aut(Λ)} (hg : g ∈ F.finiteWeyl) :
    g rankUnit = rankUnit := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨c, -, h, rfl⟩ := hx
    rw [reflectEquiv_apply]
    exact reflect_of_pairing_eq_zero b (by simp [rankUnit])
  | one => rfl
  | mul x y _ _ hx hy => rw [mul_apply_eq_comp, hy, hx]
  | inv x _ hx => rw [LinearEquiv.coe_inv, LinearEquiv.symm_apply_eq, hx]

/-- **`W(R) ∩ E(Q) = 1`**: `W(R)` fixes `(1, 0, 0)`, and `⊗𝒪(D)` sends it to `(1, D, D²/2)`. -/
theorem disjoint_finiteWeyl_translations (hb : ∀ x y, b x y = b y x) :
    Disjoint F.finiteWeyl F.translations := by
  rw [Subgroup.disjoint_def]
  intro g hW hE
  obtain ⟨D, -, hg⟩ := (F.mem_translations_iff hb).mp hE
  have h1 := F.finiteWeyl_apply_rankUnit hW
  rw [hg] at h1
  have hD0 : D = 0 := by simpa [rankUnit] using congrArg (fun v => v.2.1) h1
  subst hD0
  exact LinearEquiv.ext fun v => by rw [hg]; simp

/-- **`E(Q)` and `W(R)` are complements in `W_aff`.** -/
theorem isComplement' (hb : ∀ x y, b x y = b y x) :
    (F.translations.subgroupOf F.affineWeyl).IsComplement'
      (F.finiteWeyl.subgroupOf F.affineWeyl) := by
  refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
  · rw [Subgroup.disjoint_def]
    intro x hE hW
    exact Subtype.ext (Subgroup.disjoint_def.mp (F.disjoint_finiteWeyl_translations hb)
      (Subgroup.mem_subgroupOf.mp hW) (Subgroup.mem_subgroupOf.mp hE))
  · refine Set.eq_univ_of_forall fun ⟨g, hg⟩ => ?_
    obtain ⟨t, ht, w, hw, htw⟩ := F.exists_mul_eq_of_mem_affineWeyl hb hg
    exact Set.mem_mul.mpr ⟨⟨t, F.translations_le_affineWeyl hb ht⟩,
      Subgroup.mem_subgroupOf.mpr ht, ⟨w, F.finiteWeyl_le_affineWeyl hw⟩,
      Subgroup.mem_subgroupOf.mpr hw, Subtype.ext htw⟩

/-- **`W_aff ≃* E(Q) ⋊ W(R)`**, the semidirect product of the translations by the finite Weyl group
acting by conjugation. -/
noncomputable def affineWeylEquiv (hb : ∀ x y, b x y = b y x) :=
  @SemidirectProduct.mulEquivSubgroup _ _ _ _ (F.translations_normal hb) (F.isComplement' hb)

/-! ### Line bundles normalize the affine Weyl group -/

/-- An isometry that fixes the rank-zero classes up to their last coordinate,
`g (0, c, s) = (0, c, s')`, conjugates `W_aff` into itself:
`g ρ_{(0, c, s)} g⁻¹ = ρ_{(0, c, s')}`. -/
theorem conj_mem_affineWeyl {g : Aut(Λ)} (hg : g ∈ orthogonalGroup b)
    (hgen : ∀ c s, ∃ s', g ((0, c, s) : MukaiLattice ℤ N) = (0, c, s')) {h : Aut(Λ)}
    (hh : h ∈ F.affineWeyl) : g * h * g⁻¹ ∈ F.affineWeyl := by
  induction hh using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨c, hcQ, s, hs, rfl⟩ := hx
    obtain ⟨s', hs'⟩ := hgen c s
    have hc : b c c = -2 := by simpa [IsSpherical] using hs
    refine Subgroup.subset_closure ⟨c, hcQ, s', isSpherical_rankZero hc s', ?_⟩
    refine LinearEquiv.ext fun w => ?_
    rw [mul_apply_eq_comp, mul_apply_eq_comp, LinearEquiv.coe_inv, reflectEquiv_apply,
      apply_reflect_symm hg, hs', reflectEquiv_apply]
  | one => simp
  | mul x y _ _ hx hy =>
    have : g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) := by group
    rw [this]
    exact mul_mem hx hy
  | inv x _ hx =>
    have : g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ := by group
    rw [this]
    exact inv_mem hx

/-- **An isometry fixing the rank-zero classes up to their last coordinate normalizes `W_aff`.** -/
theorem mem_normalizer_affineWeyl {g : Aut(Λ)} (hg : g ∈ orthogonalGroup b)
    (hgen : ∀ c s, ∃ s', g ((0, c, s) : MukaiLattice ℤ N) = (0, c, s'))
    (hgen' : ∀ c s, ∃ s', g.symm ((0, c, s) : MukaiLattice ℤ N) = (0, c, s')) :
    g ∈ Subgroup.normalizer (F.affineWeyl : Set Aut(Λ)) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  refine ⟨F.conj_mem_affineWeyl hg hgen, fun hh => ?_⟩
  have := F.conj_mem_affineWeyl (inv_mem hg) (by simpa using hgen') hh
  rwa [show g⁻¹ * (g * h * g⁻¹) * g⁻¹⁻¹ = h by group] at this

/-- **`⊗𝒪(L)` normalizes `W_aff`**: `⊗𝒪(L) ρ_{(0, c, s)} ⊗𝒪(-L) = ρ_{(0, c, s + c·L)}`. -/
theorem lineTwists_le_normalizer (hb : ∀ x y, b x y = b y x) :
    lineTwists b ≤ Subgroup.normalizer (F.affineWeyl : Set Aut(Λ)) := by
  rw [lineTwists, Subgroup.closure_le]
  rintro g ⟨L, q, hq, hg⟩
  have hiso : g ∈ orthogonalGroup b := fun v w => by
    simp only [mukaiForm_apply] at *
    rw [hg, hg]
    exact mukaiForm_tensorLine b hb hq v w
  refine F.mem_normalizer_affineWeyl hiso (fun c s => ⟨s + b c L, ?_⟩) (fun c s => ⟨s - b c L, ?_⟩)
  · rw [hg]
    ext <;> simp
  · rw [LinearEquiv.symm_apply_eq, hg]
    ext <;> simp

/-- **The extended affine Weyl group** `W(R) ⋉ E(N)` on the Mukai lattice: generated by `W_aff`
and the isometric line bundles. -/
def extendedAffineWeyl : Subgroup Aut(Λ) :=
  F.affineWeyl ⊔ lineTwists b

/-- **`W_aff` is normal in the extended affine Weyl group.** -/
theorem affineWeyl_normal (hb : ∀ x y, b x y = b y x) :
    (F.affineWeyl.subgroupOf F.extendedAffineWeyl).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
    (sup_le Subgroup.le_normalizer (F.lineTwists_le_normalizer hb))

end FundamentalCycle

