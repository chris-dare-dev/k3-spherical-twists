import K3Twists.GroupTheory.Coxeter.GeometricRepresentation

/-!
# The deletion argument for words of reflections

Let `b` be a symmetric bilinear form on an abelian group `Λ`, `α : B → Λ` vectors of norm `-2`,
and `P ⊆ Λ` a set of *positive* vectors containing every `α_i`, such that each reflection `ρ_i`
maps `P ∖ {α_i}` into `P`. For the positive roots of a root system with simple roots `α_i` this is
the classical statement that `s_i` permutes the positive roots other than `α_i` (Humphreys,
*Reflection groups and Coxeter groups*, Proposition 1.4). From it alone:

* **The first sign change** (`BilinearForm.exists_split_of_reflectWord_notMem`): if `v ∈ P` and
  `ρ_ω v ∉ P` for a word `ω`, then `ω = ω₁ ++ j :: ω₂` with `ρ_{ω₂} v = α_j`.
* **Deletion** (`BilinearForm.exists_reflectWord_eq_of_notMem`): if the last prefix root
  `ρ_ω(α_i)` of `ω ++ [i]` is not in `P`, then `ω = ω₁ ++ j :: ω₂` and `ω ++ [i]` acts as
  `ω₁ ++ ω₂`, a word two letters shorter. The proof: `ρ_{ω₂}(α_i) = α_j` gives
  `ρ_j ρ_{ω₂} = ρ_{ω₂} ρ_i` (`BilinearForm.reflect_reflectWord`), because a word acts by an
  isometry.
* **Minimal words are positive** (`BilinearForm.prefixRoots_mem_of_minimal`): if no shorter word
  has the same action as `ω`, every prefix root of `ω` lies in `P`.
* **Trivial stabilizer** (`BilinearForm.reflectWord_eq_one_of_forall_mem`): if moreover `P`
  contains no pair `v, -v`, a word whose action keeps every `α_i` in `P` acts as the identity.

These are statements about the action of words, not about the abstract Coxeter group, so they
need no faithfulness of the reflection representation; with `P` the positive roots they are the
linear form of the exchange and deletion conditions (Humphreys, §1.6–§1.7). Tits' positivity
theorem for the abstract group (`CoxeterMatrix.CoxeterPositivity`) is a different statement and
stays open.

Also: every element of the group generated by the `ρ_i` is the action of a word
(`BilinearForm.exists_reflectWord_of_mem_closure`), and a word followed by its reverse acts
trivially (`BilinearForm.reflectWord_reverse_apply`).
-/

namespace BilinearForm

variable {B Λ : Type*} [AddCommGroup Λ] {b : LinearMap.BilinForm ℤ Λ} {α : B → Λ}

/-! ### Words act by isometries -/

/-- A word acts by an isometry of a symmetric form. -/
theorem apply_reflectWord_reflectWord (hb : ∀ x y, b x y = b y x)
    (hα : ∀ i, b (α i) (α i) = -2) (ω : List B) (v w : Λ) :
    b (reflectWord b α ω v) (reflectWord b α ω w) = b v w := by
  induction ω with
  | nil => rfl
  | cons i ω ih =>
    rw [reflectWord_cons_apply, reflectWord_cons_apply, apply_reflect_reflect b hb _ (hα i), ih]

/-- **Equivariance.** If a word sends `α_i` to `α_j`, it intertwines the two reflections:
`ρ_j ∘ ρ_ω = ρ_ω ∘ ρ_i`. -/
theorem reflect_reflectWord (hb : ∀ x y, b x y = b y x) (hα : ∀ i, b (α i) (α i) = -2)
    {ω : List B} {i j : B} (h : reflectWord b α ω (α i) = α j) (v : Λ) :
    reflect b (α j) (reflectWord b α ω v) = reflectWord b α ω (reflect b (α i) v) := by
  rw [reflect_apply, reflect_apply, map_add, map_zsmul, ← h,
    apply_reflectWord_reflectWord hb hα]

/-- A word followed by its reverse acts trivially. -/
theorem reflectWord_reverse_apply (hα : ∀ i, b (α i) (α i) = -2) (ω : List B) (v : Λ) :
    reflectWord b α ω.reverse (reflectWord b α ω v) = v := by
  induction ω generalizing v with
  | nil => rfl
  | cons i ω ih =>
    rw [List.reverse_cons, reflectWord_append_apply, reflectWord_cons_apply, reflectWord_cons_apply,
      reflectWord_nil, one_apply_eq_self, reflect_reflect b _ (hα i), ih]

/-- **Every element of the group generated by the reflections `ρ_i` is the action of a word.** -/
theorem exists_reflectWord_of_mem_closure (hα : ∀ i, b (α i) (α i) = -2) {g : Λ ≃ₗ[ℤ] Λ}
    (hg : g ∈ Subgroup.closure (Set.range fun i => reflectEquiv b (α i) (hα i))) :
    ∃ ω : List B, ∀ v, g v = reflectWord b α ω v := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨[i], fun v => by simp⟩
  | one => exact ⟨[], fun v => rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨ω, hω⟩ := hx
    obtain ⟨ω', hω'⟩ := hy
    exact ⟨ω ++ ω', fun v => by rw [reflectWord_append_apply, ← hω', ← hω]; rfl⟩
  | inv x _ hx =>
    obtain ⟨ω, hω⟩ := hx
    refine ⟨ω.reverse, fun v => ?_⟩
    rw [LinearEquiv.coe_inv, LinearEquiv.symm_apply_eq, hω]
    have := reflectWord_reverse_apply hα ω.reverse v
    rw [List.reverse_reverse] at this
    exact this.symm

/-! ### The first sign change and deletion -/

variable (P : Set Λ)

/-- **The first sign change.** Let each `ρ_j` map `P ∖ {α_j}` into `P`. If `v ∈ P` and
`ρ_ω v ∉ P`, then `ω = ω₁ ++ j :: ω₂` with `ρ_{ω₂} v = α_j`. -/
theorem exists_split_of_reflectWord_notMem
    (hP : ∀ j, ∀ v ∈ P, v ≠ α j → reflect b (α j) v ∈ P) {v : Λ} (hv : v ∈ P) {ω : List B}
    (h : reflectWord b α ω v ∉ P) :
    ∃ ω₁ j ω₂, ω = ω₁ ++ j :: ω₂ ∧ reflectWord b α ω₂ v = α j := by
  induction ω with
  | nil => exact absurd hv h
  | cons j ω ih =>
    by_cases h' : reflectWord b α ω v ∈ P
    · refine ⟨[], j, ω, rfl, ?_⟩
      by_contra hne
      exact h (by rw [reflectWord_cons_apply]; exact hP j _ h' hne)
    · obtain ⟨ω₁, k, ω₂, rfl, hk⟩ := ih h'
      exact ⟨j :: ω₁, k, ω₂, rfl, hk⟩

/-- **Deletion.** If the last prefix root `ρ_ω(α_i)` of `ω ++ [i]` is not in `P`, then
`ω = ω₁ ++ j :: ω₂` and `ω ++ [i]` acts as the word `ω₁ ++ ω₂`, two letters shorter. -/
theorem exists_reflectWord_eq_of_notMem (hb : ∀ x y, b x y = b y x)
    (hα : ∀ i, b (α i) (α i) = -2) (hP : ∀ j, ∀ v ∈ P, v ≠ α j → reflect b (α j) v ∈ P)
    (hαP : ∀ i, α i ∈ P) {ω : List B} {i : B} (h : reflectWord b α ω (α i) ∉ P) :
    ∃ ω₁ j ω₂, ω = ω₁ ++ j :: ω₂ ∧ reflectWord b α (ω ++ [i]) = reflectWord b α (ω₁ ++ ω₂) := by
  obtain ⟨ω₁, j, ω₂, rfl, hj⟩ := exists_split_of_reflectWord_notMem P hP (hαP i) h
  refine ⟨ω₁, j, ω₂, rfl, LinearMap.ext fun v => ?_⟩
  rw [List.append_assoc, List.cons_append, reflectWord_append_apply, reflectWord_cons_apply,
    reflectWord_append_apply, reflectWord_cons_apply, reflectWord_nil, one_apply_eq_self,
    reflect_reflectWord hb hα hj, reflect_reflect b _ (hα i), reflectWord_append_apply]

/-- A word of minimal length with a given action. -/
theorem exists_minimal (ω : List B) :
    ∃ ω₀ : List B, reflectWord b α ω₀ = reflectWord b α ω ∧
      ∀ ω' : List B, reflectWord b α ω' = reflectWord b α ω → ω₀.length ≤ ω'.length := by
  classical
  have hex : ∃ n, ∃ ω' : List B, ω'.length = n ∧ reflectWord b α ω' = reflectWord b α ω :=
    ⟨_, ω, rfl, rfl⟩
  obtain ⟨ω₀, hlen, hω₀⟩ := Nat.find_spec hex
  exact ⟨ω₀, hω₀, fun ω' hω' => hlen ▸ Nat.find_min' hex ⟨ω', rfl, hω'⟩⟩

/-- **Minimal words are positive.** If no shorter word has the same action as `ω`, every prefix
root of `ω` lies in `P`. -/
theorem prefixRoots_mem_of_minimal (hb : ∀ x y, b x y = b y x) (hα : ∀ i, b (α i) (α i) = -2)
    (hP : ∀ j, ∀ v ∈ P, v ≠ α j → reflect b (α j) v ∈ P) (hαP : ∀ i, α i ∈ P) {ω : List B}
    (hmin : ∀ ω' : List B, reflectWord b α ω' = reflectWord b α ω → ω.length ≤ ω'.length) :
    ∀ β ∈ prefixRoots b α ω, β ∈ P := by
  induction ω using List.reverseRecOn with
  | nil => simp
  | append_singleton ω i ih =>
    have hmin' : ∀ ω' : List B, reflectWord b α ω' = reflectWord b α ω →
        ω.length ≤ ω'.length := by
      intro ω' hω'
      have := hmin (ω' ++ [i]) (by rw [reflectWord_append, reflectWord_append, hω'])
      simpa using this
    intro β hβ
    rw [prefixRoots_append_singleton, List.mem_append, List.mem_singleton] at hβ
    rcases hβ with hβ | rfl
    · exact ih hmin' β hβ
    · by_contra hn
      obtain ⟨ω₁, j, ω₂, rfl, heq⟩ := exists_reflectWord_eq_of_notMem P hb hα hP hαP hn
      have := hmin _ heq.symm
      simp only [List.length_append, List.length_cons] at this
      omega

/-- **Trivial stabilizer.** Let `P` contain no pair `v, -v`. A word whose action keeps every `α_i`
in `P` acts as the identity. -/
theorem reflectWord_eq_one_of_forall_mem (hb : ∀ x y, b x y = b y x)
    (hα : ∀ i, b (α i) (α i) = -2) (hP : ∀ j, ∀ v ∈ P, v ≠ α j → reflect b (α j) v ∈ P)
    (hαP : ∀ i, α i ∈ P) (hneg : ∀ v ∈ P, -v ∉ P) (ω : List B)
    (h : ∀ i, reflectWord b α ω (α i) ∈ P) : reflectWord b α ω = 1 := by
  obtain ⟨ω₀, hω₀, hmin⟩ := exists_minimal (b := b) (α := α) ω
  rw [← hω₀]
  induction ω₀ using List.reverseRecOn with
  | nil => rfl
  | append_singleton ω' i _ =>
    exfalso
    have hpos := prefixRoots_mem_of_minimal P hb hα hP hαP (ω := ω' ++ [i])
      (fun ω'' h'' => hmin ω'' (h''.trans hω₀))
    have h1 : reflectWord b α ω' (α i) ∈ P :=
      hpos _ (by rw [prefixRoots_append_singleton]; simp)
    have h2 := h i
    rw [← hω₀, reflectWord_append_apply, reflectWord_cons_apply, reflectWord_nil,
      one_apply_eq_self, reflect_self _ _ (hα i), map_neg] at h2
    exact hneg _ h1 h2

end BilinearForm
