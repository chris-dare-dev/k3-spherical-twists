import K3Twists.GroupTheory.GroupAction.TwistSystem

/-!
# Maps of twist systems on the orbit of the centres

`HomTwistSystem₀.maxCount_eq_of_map` and `HomTwistSystem₀.homExponent_eq_of_map` compare two twist
systems through a map of objects that matches letters and counts on all objects. The counts
`P_q = max h(S_i, W S_j)` only see the orbit of the centres under words, the objects `W S_j`, so
compatibility there is enough:

* `HomTwistSystem₀.centreOrbit H`: the objects `W S_j`, for words `W` in the letters and centres
  `S_j`; it contains the centres and is stable under the letters;
* `HomTwistSystem₀.h_word_map_orbit`, `maxCount_eq_of_map_orbit`, `homExponent_eq_of_map_orbit`:
  a map `f` with `f(S_i) = S'_i`, `f(T_a V) = T'_a f(V)` for `V` in the orbit, and
  `h'(f(S_i), f(V)) = h(S_i, V)` for `V` in the orbit, has `P'_q = P_q` for every `q`, hence the
  same exponent `η`.

Nothing is asked of `f` away from the orbit, so `f` may be defined on the thick subcategory
generated by the centres only, as a functor out of the marked category of the centres is: the
exponent depends only on the centres, the letters and the counts from the centres to their
translates.
-/

namespace HomTwistSystem₀

variable {G Obj ι α : Type*} [Group G] [MulAction G Obj] (H : HomTwistSystem₀ G Obj ι α)

/-- The orbit of the centres under words in the letters: the objects `W S_j`. -/
def centreOrbit : Set Obj := {V | ∃ (w : List α) (j : ι), V = H.word w • H.S j}

lemma word_smul_mem_centreOrbit (w : List α) (j : ι) : H.word w • H.S j ∈ H.centreOrbit :=
  ⟨w, j, rfl⟩

lemma centre_mem_centreOrbit (j : ι) : H.S j ∈ H.centreOrbit :=
  ⟨[], j, by rw [word_nil, one_smul]⟩

/-- The orbit is stable under the letters. -/
lemma letter_smul_mem_centreOrbit (a : α) {V : Obj} (hV : V ∈ H.centreOrbit) :
    H.T a • V ∈ H.centreOrbit := by
  obtain ⟨w, j, rfl⟩ := hV
  exact ⟨a :: w, j, by rw [word_cons, mul_smul]⟩

section Map

variable {G' Obj' : Type*} [Group G'] [MulAction G' Obj'] (H' : HomTwistSystem₀ G' Obj' ι α)

/-- **Counts of words, on the orbit.** A map of objects that sends centres to centres, intertwines
the letters on the orbit of the centres and preserves the counts from the centres to the orbit
carries the counts `h(S_i, W S_j)` to the same counts. -/
theorem h_word_map_orbit (f : Obj → Obj') (hS : ∀ i, f (H.S i) = H'.S i)
    (hT : ∀ a, ∀ V ∈ H.centreOrbit, f (H.T a • V) = H'.T a • f V)
    (hh : ∀ i, ∀ V ∈ H.centreOrbit, H'.h (f (H.S i)) (f V) = H.h (H.S i) V)
    (i j : ι) (w : List α) :
    H'.h (H'.S i) (H'.word w • H'.S j) = H.h (H.S i) (H.word w • H.S j) := by
  have hw : ∀ w : List α, f (H.word w • H.S j) = H'.word w • H'.S j := by
    intro w
    induction w with
    | nil => rw [word_nil, word_nil, one_smul, one_smul, hS]
    | cons a w ih =>
      rw [word_cons, word_cons, mul_smul, mul_smul, hT a _ (H.word_smul_mem_centreOrbit w j), ih]
  rw [← hw, ← hS, hh i _ (H.word_smul_mem_centreOrbit w j)]

variable [Fintype ι] [Fintype α]

/-- **Invariance of `P_q`, on the orbit**: a map compatible with the letters and the counts on the
orbit of the centres has `P'_q = P_q` for every `q`. -/
theorem maxCount_eq_of_map_orbit (f : Obj → Obj') (hS : ∀ i, f (H.S i) = H'.S i)
    (hT : ∀ a, ∀ V ∈ H.centreOrbit, f (H.T a • V) = H'.T a • f V)
    (hh : ∀ i, ∀ V ∈ H.centreOrbit, H'.h (f (H.S i)) (f V) = H.h (H.S i) V) (q : ℕ) :
    H'.maxCount q = H.maxCount q := by
  unfold maxCount
  congr 1
  funext x
  exact H.h_word_map_orbit H' f hS hT hh x.1 x.2.1 (List.ofFn x.2.2.2)

/-- **Invariance of the exponent, on the orbit.** -/
theorem homExponent_eq_of_map_orbit (f : Obj → Obj') (hS : ∀ i, f (H.S i) = H'.S i)
    (hT : ∀ a, ∀ V ∈ H.centreOrbit, f (H.T a • V) = H'.T a • f V)
    (hh : ∀ i, ∀ V ∈ H.centreOrbit, H'.h (f (H.S i)) (f V) = H.h (H.S i) V) :
    H'.homExponent = H.homExponent := by
  unfold homExponent
  simp_rw [H.maxCount_eq_of_map_orbit H' f hS hT hh]

end Map

end HomTwistSystem₀
