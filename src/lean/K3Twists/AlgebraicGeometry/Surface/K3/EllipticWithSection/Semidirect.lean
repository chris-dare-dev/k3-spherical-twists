import K3Twists.AlgebraicGeometry.Surface.K3.EllipticWithSection.LengthZeroGroup
import K3Twists.LinearAlgebra.Lattice.Mukai.AffineWeyl.Semidirect
import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# The extended affine Weyl group of the curve wall as `W ⋉ Λ`

On the elliptic K3 surface `X` with a section `C` (`EllipticWithSection/Lattice.lean`), the curve
wall contracts `C` (`sectionFibre`, type `A₁`, `Θ = C`). The fibre class has `F·C = 1`, so
`Λ = ℤ = P^∨` (`degreeLattice_sectionFibre`), while `Q^∨ = 2ℤ`; and `NS(X)` is even
(`intersection_even`). The theorems of `LinearAlgebra/Lattice/Mukai/AffineWeyl/Semidirect.lean`
give, on the real classes:

* **`W(A₁) = {1, ρ_{wallB}}` has order two** (`finiteWeyl_sectionFibre_eq_zpowers`,
  `eq_one_or_eq_wallBReflection`, `card_finiteWeyl_sectionFibre`), and the reflection in
  `wallB = v(𝒪_C(-1)[1])` acts on `Λ = ℤ` by `λ ↦ -λ` (`coweightRep_wallBReflection`). So
  `W ⋉ Λ = ℤ/2 ⋉ ℤ` is **the infinite dihedral group**, Mathlib's `DihedralGroup 0`
  (`degreeSemidirectEquivDihedral`).
* **The extended affine Weyl group maps onto it** (`toDegreeSemidirect_sectionFibre_surjective`),
  with kernel the twists by the multiples of `H = C + 2F`, the classes orthogonal to `C`
  (`mem_ker_toDegreeSemidirect_sectionFibre`). The length-zero element `π = ⊗𝒪(F) ∘ ρ_{wallB}`
  maps to `(1, ρ_{wallB})` (`toDegreeSemidirect_lengthZero`).
* **`(W ⋉ Λ)/(W ⋉ Q^∨)` has order two** (`card_quotient_corootSemidirect_sectionFibre`): it is
  `Λ/Q^∨ = ℤ/2`.

That `C` is the exceptional fibre of the contraction by `H` and that the simple objects of the
wall are `𝒪_C` and `𝒪_C(-1)[1]` are geometry and are not formalized.
-/

namespace AlgebraicGeometry.K3.EllipticWithSection

open Mukai Mukai.FundamentalCycle

/-- Automorphisms of the Mukai lattice of `X`. -/
local notation "Aut(Λ)" => MukaiLattice ℤ NS ≃ₗ[ℤ] MukaiLattice ℤ NS

/-! ### The finite Weyl group `W(A₁)` -/

/-- **The reflection in `wallB = v(𝒪_C(-1)[1])`**, as an element of `W(A₁)`: the simple
reflection of the finite node. -/
noncomputable def wallBReflection : sectionFibre.finiteWeyl :=
  ⟨sectionFibre.simpleReflection (some ()), sectionFibre.simpleReflection_mem_finiteWeyl ()⟩

theorem wallBReflection_apply (v : MukaiLattice ℤ NS) :
    (wallBReflection : Aut(Λ)) v = reflect intersection wallB v := by
  rw [wallBReflection, simpleReflection_apply, sectionFibre_affineRoot_some]

theorem coe_wallBReflection :
    (wallBReflection : Aut(Λ)) = reflectEquiv intersection wallB isSpherical_wallB :=
  LinearEquiv.ext fun v => by rw [wallBReflection_apply, reflectEquiv_apply]

theorem wallBReflection_mul_self : wallBReflection * wallBReflection = 1 :=
  Subtype.ext (sectionFibre.simpleReflection_mul_self _)

theorem wallBReflection_ne_one : wallBReflection ≠ 1 := by
  intro h
  have := congrArg (fun g : sectionFibre.finiteWeyl => ((g : Aut(Λ)) wallB).2.1.1) h
  simp only [wallBReflection_apply, reflect_self _ _ isSpherical_wallB, OneMemClass.coe_one,
    one_apply_eq_self] at this
  simp [wallB, curve] at this

/-- **`W(A₁)` is generated by the reflection in `wallB`.** -/
theorem finiteWeyl_sectionFibre_eq_zpowers :
    sectionFibre.finiteWeyl =
      Subgroup.zpowers (reflectEquiv intersection wallB isSpherical_wallB) := by
  rw [sectionFibre.finiteWeyl_eq_closure intersection_comm, Subgroup.zpowers_eq_closure]
  congr 1
  ext g
  simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and, Set.mem_singleton_iff]
  constructor
  · rintro ⟨⟨⟩, rfl⟩
    exact coe_wallBReflection
  · rintro rfl
    exact ⟨(), coe_wallBReflection⟩

/-- **`W(A₁)` has order two.** -/
theorem card_finiteWeyl_sectionFibre : Nat.card sectionFibre.finiteWeyl = 2 := by
  rw [finiteWeyl_sectionFibre_eq_zpowers, Nat.card_zpowers, ← coe_wallBReflection]
  refine orderOf_eq_prime ?_ fun h => wallBReflection_ne_one (Subtype.ext h)
  rw [sq, ← Subgroup.coe_mul, wallBReflection_mul_self]
  rfl

/-- **`W(A₁) = {1, ρ_{wallB}}`.** -/
theorem eq_one_or_eq_wallBReflection (w : sectionFibre.finiteWeyl) :
    w = 1 ∨ w = wallBReflection := by
  have hw : (w : Aut(Λ)) ∈ Subgroup.zpowers (wallBReflection : Aut(Λ)) := by
    rw [coe_wallBReflection, ← finiteWeyl_sectionFibre_eq_zpowers]
    exact w.2
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hw
  have h2 : (wallBReflection : Aut(Λ)) ^ (2 : ℤ) = 1 := by
    rw [zpow_two, ← Subgroup.coe_mul, wallBReflection_mul_self]
    rfl
  rcases Int.even_or_odd' k with ⟨m, rfl | rfl⟩
  · left
    apply Subtype.ext
    rw [← hk, zpow_mul, h2, one_zpow]
    rfl
  · right
    apply Subtype.ext
    rw [← hk, zpow_add_one, zpow_mul, h2, one_zpow, one_mul]

/-- `ρ_{wallB}` acts on the root lattice `ℤC` by `-1`. -/
theorem rootRep_wallBReflection (d : Unit → ℤ) :
    sectionFibre.rootRep wallBReflection d = -d := by
  apply sectionFibre.combination_injective
  rw [combination_rootRep, wallBReflection_apply]
  ext <;> simp [reflect_apply, combination_apply, wallB, curve]
  ring

/-- **`ρ_{wallB}` acts on `Λ = ℤ` by `λ ↦ -λ`**: `W ⋉ Λ` is `ℤ/2 ⋉ ℤ` with the sign action, the
infinite dihedral group. -/
theorem coweightRep_wallBReflection (x : Unit → ℤ) :
    sectionFibre.coweightRep wallBReflection x = -x := by
  have hinv : wallBReflection⁻¹ = wallBReflection :=
    inv_eq_of_mul_eq_one_left wallBReflection_mul_self
  ext u
  have := sectionFibre.coweightRep_dotProduct wallBReflection x fun _ => 1
  rw [hinv, rootRep_wallBReflection] at this
  simpa [dotProduct] using this

/-! ### `W ⋉ Λ` and its quotient -/

/-- Every coweight is a degree: `Λ = ℤ`. -/
theorem mem_degreeLattice_sectionFibre (x : Unit → ℤ) : x ∈ sectionFibre.degreeLattice := by
  rw [degreeLattice_sectionFibre]
  trivial

open Classical in
/-- **`W ⋉ Λ` of the curve wall is the infinite dihedral group** `ℤ ⋊ ℤ/2`: `(λ, 1) ↦ rλ`,
`(λ, ρ_{wallB}) ↦ sr(-λ)`. -/
noncomputable def degreeSemidirectEquivDihedral :
    sectionFibre.DegreeSemidirect intersection_comm ≃* DihedralGroup 0 where
  toFun z :=
    if z.right = 1 then
      .r (Int.cast (((Multiplicative.toAdd z.left : sectionFibre.degreeLattice) : Unit → ℤ) ()))
    else
      .sr (Int.cast (-((Multiplicative.toAdd z.left : sectionFibre.degreeLattice) : Unit → ℤ) ()))
  invFun
    | .r i => ⟨.ofAdd ⟨fun _ => ZMod.cast i, mem_degreeLattice_sectionFibre _⟩, 1⟩
    | .sr i => ⟨.ofAdd ⟨fun _ => -ZMod.cast i, mem_degreeLattice_sectionFibre _⟩, wallBReflection⟩
  left_inv z := by
    obtain ⟨x, w⟩ := z
    rcases eq_one_or_eq_wallBReflection w with rfl | rfl
    · refine SemidirectProduct.ext (Multiplicative.toAdd.injective (Subtype.ext ?_)) (by simp)
      funext u
      simp
    · refine SemidirectProduct.ext (Multiplicative.toAdd.injective (Subtype.ext ?_))
        (by simp [wallBReflection_ne_one])
      funext u
      simp [wallBReflection_ne_one]
  right_inv d := by
    cases d with
    | r i => simp
    | sr i => simp [wallBReflection_ne_one]
  map_mul' z z' := by
    obtain ⟨x, w⟩ := z
    obtain ⟨x', w'⟩ := z'
    rcases eq_one_or_eq_wallBReflection w with rfl | rfl <;>
      rcases eq_one_or_eq_wallBReflection w' with rfl | rfl <;>
      simp [wallBReflection_mul_self, wallBReflection_ne_one, coweightRep_wallBReflection] <;>
      ring



/-- **The extended affine Weyl group of the curve wall maps onto `W ⋉ Λ`**: `NS(X)` is even. -/
theorem toDegreeSemidirect_sectionFibre_surjective :
    Function.Surjective (sectionFibre.toDegreeSemidirect intersection_comm) :=
  sectionFibre.toDegreeSemidirect_surjective intersection_comm intersection_even

/-- **The kernel is the group of twists by the multiples of `H = C + 2F`**: `L·C = 0` iff `L = aH`,
and then `L²/2 = a²`. -/
theorem mem_ker_toDegreeSemidirect_sectionFibre (g : sectionFibre.extendedAffineWeyl) :
    g ∈ (sectionFibre.toDegreeSemidirect intersection_comm).ker ↔
      ∃ a : ℤ, ∀ v, (g : Aut(Λ)) v = tensorLine intersection (a • polarization) (a ^ 2) v := by
  rw [ker_toDegreeSemidirect, Subgroup.mem_subgroupOf,
    sectionFibre.mem_orthogonalLineTwists_iff intersection_comm]
  constructor
  · rintro ⟨⟨x, y⟩, q, hq, hL, hg⟩
    have hy : y = 2 * x := by
      have := hL ()
      simp only [sectionFibre_curve, intersection_curve_apply] at this
      linarith
    subst hy
    have hq' : q = x ^ 2 := by
      rw [intersection_self] at hq
      linarith
    refine ⟨x, fun v => ?_⟩
    rw [hg, hq', show ((x, 2 * x) : NS) = x • polarization by ext <;> simp [polarization]; ring]
  · rintro ⟨a, hg⟩
    refine ⟨a • polarization, a ^ 2, ?_, fun _ => ?_, hg⟩
    · simp [polarization]
      ring
    · simp [polarization]
      ring

/-- **`(W ⋉ Λ)/(W ⋉ Q^∨)` has order two**: it is `Λ/Q^∨ = ℤ/2ℤ`. -/
theorem card_quotient_corootSemidirect_sectionFibre :
    Nat.card (sectionFibre.DegreeSemidirect intersection_comm ⧸
      sectionFibre.corootSemidirect intersection_comm) = 2 := by
  rw [sectionFibre.card_quotient_corootSemidirect_of_degreeLattice intersection_comm
    degreeLattice_sectionFibre, det_cartan_sectionFibre]
  rfl

/-- **The length-zero element `π = ⊗𝒪(F) ∘ ρ_{wallB}` maps to `(1, ρ_{wallB})`**: `F·C = 1`. -/
theorem toDegreeSemidirect_lengthZero :
    sectionFibre.toDegreeSemidirect intersection_comm
        ⟨lengthZero, lengthZero_mem_lengthZeroGroup.2⟩ =
      ⟨.ofAdd ⟨fun _ => 1, fibre, by ext; simp [fibre, curve]⟩, wallBReflection⟩ := by
  rw [sectionFibre.toDegreeSemidirect_eq intersection_comm _ wallBReflection.2 (L := fibre)
    (q := 0) fun v => by rw [coe_wallBReflection]; rfl]
  refine SemidirectProduct.ext (Multiplicative.toAdd.injective (Subtype.ext ?_)) rfl
  ext
  simp [fibre, curve]

end AlgebraicGeometry.K3.EllipticWithSection
