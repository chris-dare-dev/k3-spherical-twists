import K3Twists.LinearAlgebra.Matrix.UnitSpectrum
import K3Twists.RingTheory.IntegralClosure.Specialization
import Mathlib.RingTheory.Adjoin.FG

/-!
# The S-unit theorem for spectral moduli of a matrix semigroup

Let `A_a`, `a ∈ ι`, be finitely many invertible complex matrices. There is `N ≥ 1` such that,
whenever the modulus `|z|` of an eigenvalue `z` of a product `A_{a₁} ⋯ A_{a_j}` is a root of a
monic polynomial `P ∈ ℤ[X]` irreducible over `ℚ`, the constant term `P(0)` divides a power of `N`
(`spectral_moduli_norms_divide_pow`). Up to sign `P(0)` is the norm of `|z|`, so the norms of
all algebraic spectral moduli of the semigroup are `S`-units for the primes dividing `N`. No
positivity, no maximality of `|z|` and no relation between the letters is assumed; only the
entries of the inverse matrices enter.

The proof: let `R ⊆ ℂ` be the ring generated by the entries of the `A_a⁻¹` and their complex
conjugates. For an eigenvalue `z` of a product, `z⁻¹` and `z̄⁻¹` are eigenvalues of products of
the `A_a⁻¹` and of their conjugates, so `|z|⁻¹` is integral over `R`
(`Matrix.isIntegral_norm_inv_of_mem_spectrum`). The specialization lemma
(`exists_specialization`, from Zariski's lemma and lying over) makes `|z|⁻¹` integral over
`ℤ[1/N]` for one `N`, and the arithmetic core `coeff_zero_dvd_pow` concludes.

When the entries of the `A_a⁻¹` are algebraic numbers, `N` can be any common denominator of them,
and no specialization is needed (`spectral_moduli_norms_divide_pow_of_mem`).

## Main results

* `coeff_zero_dvd_pow_of_mem_spectrum`: the conclusion for one product, from integrality of the
  inverse entries over `ℤ[1/N]`.
* `spectral_moduli_norms_divide_pow_of_mem`: the theorem with an explicit `N` clearing the
  denominators of the entries of the inverse letters.
* `spectral_moduli_norms_divide_pow`: the theorem for any invertible complex letters.
* `no_invertible_family`: the family form. A family of words `W s` whose spectral moduli `x s`
  are roots of monic irreducible `Q s ∈ ℤ[X]` with unboundedly many primes dividing the constant
  terms is not realized by invertible complex letters.
-/

open Polynomial ComplexConjugate

namespace Matrix

variable {ι : Type*} {n : Type*} [Fintype n] [DecidableEq n]

/-- **One product, explicit `N`.** If the entries of `M⁻¹` are integral over `ℤ[1/N]`, `N ≠ 0`,
and the modulus of an eigenvalue of `M` is a root of a monic `P ∈ ℤ[X]` irreducible over `ℚ`, then
`P(0)` divides a power of `N`. -/
theorem coeff_zero_dvd_pow_of_mem_spectrum {M : Matrix n n ℂ} (hM : IsUnit M) {N : ℕ}
    (hN : N ≠ 0) (hinv : ∀ i j, M⁻¹ i j ∈ integralClosureAway N ℂ) {z : ℂ}
    (hz : z ∈ spectrum ℂ M) {P : ℤ[X]} (hPm : P.Monic)
    (hPirr : Irreducible (P.map (Int.castRingHom ℚ))) (hroot : aeval ((‖z‖ : ℝ) : ℂ) P = 0) :
    ∃ k, P.coeff 0 ∣ (N : ℤ) ^ k := by
  have hinv' : ∀ i j, (M.map conj)⁻¹ i j ∈ integralClosureAway N ℂ := by
    intro i j
    rw [inv_map_eq_map_inv (starRingEnd ℂ) ((isUnit_iff_isUnit_det M).1 hM), map_apply]
    exact map_mem_integralClosureAway (starRingEnd ℂ) (hinv i j)
  have hint := isIntegral_norm_inv_of_mem_spectrum hM hinv hinv' hz
  have hz0 : z ≠ 0 := ne_zero_of_mem_spectrum hM hz
  exact coeff_zero_dvd_pow hPm hPirr (by simpa using hz0) hroot hN
    (mem_integralClosureAway_of_isIntegral le_rfl hint)

/-- **The S-unit theorem, explicit `N`.** Let `A_a` be invertible complex matrices such that the
entries of every `A_a⁻¹` are integral over `ℤ[1/N]`, `N ≠ 0`. If the modulus of an eigenvalue of
a product `A_{a₁} ⋯ A_{a_j}` is a root of a monic `P ∈ ℤ[X]` irreducible over `ℚ`, then `P(0)`
divides a power of `N`. -/
theorem spectral_moduli_norms_divide_pow_of_mem (A : ι → Matrix n n ℂ) (hA : ∀ a, IsUnit (A a))
    {N : ℕ} (hN : N ≠ 0) (hinv : ∀ a i j, (A a)⁻¹ i j ∈ integralClosureAway N ℂ)
    (w : List ι) {z : ℂ} (hz : z ∈ spectrum ℂ (w.map A).prod) {P : ℤ[X]} (hPm : P.Monic)
    (hPirr : Irreducible (P.map (Int.castRingHom ℚ))) (hroot : aeval ((‖z‖ : ℝ) : ℂ) P = 0) :
    ∃ k, P.coeff 0 ∣ (N : ℤ) ^ k :=
  coeff_zero_dvd_pow_of_mem_spectrum (isUnit_list_prod_map A hA w) hN
    (list_prod_inv_mem A hinv w) hz hPm hPirr hroot

/-- **The S-unit theorem for spectral moduli.** For finitely many invertible complex matrices
`A_a` there is `N > 0` such that, whenever the modulus `|z|` of an eigenvalue `z` of a product
`A_{a₁} ⋯ A_{a_j}` is a root of a monic `P ∈ ℤ[X]` irreducible over `ℚ`, the constant term `P(0)`
divides a power of `N`. -/
theorem spectral_moduli_norms_divide_pow [Finite ι] (A : ι → Matrix n n ℂ)
    (hA : ∀ a, IsUnit (A a)) :
    ∃ N : ℕ, 0 < N ∧ ∀ (w : List ι) (z : ℂ), z ∈ spectrum ℂ (w.map A).prod →
      ∀ P : ℤ[X], P.Monic → Irreducible (P.map (Int.castRingHom ℚ)) →
        aeval ((‖z‖ : ℝ) : ℂ) P = 0 → ∃ k, P.coeff 0 ∣ (N : ℤ) ^ k := by
  classical
  have := Fintype.ofFinite ι
  -- the ring generated by the inverse entries and their conjugates
  let A' : ι → Matrix n n ℂ := fun a => (A a).map conj
  let S : Set ℂ := ⋃ a, (Set.range (fun p : n × n => (A a)⁻¹ p.1 p.2) ∪
    Set.range (fun p : n × n => (A' a)⁻¹ p.1 p.2))
  have hS : S.Finite :=
    Set.finite_iUnion fun a => (Set.finite_range _).union (Set.finite_range _)
  let R : Subalgebra ℤ ℂ := Algebra.adjoin ℤ S
  have hR : R.FG := Subalgebra.fg_def.2 ⟨S, hS, rfl⟩
  obtain ⟨N, hN, hspec⟩ := exists_specialization R hR
  refine ⟨N, hN, fun w z hz P hPm hPirr hroot => ?_⟩
  have hAinv : ∀ a i j, (A a)⁻¹ i j ∈ R := fun a i j =>
    Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨a, Or.inl ⟨(i, j), rfl⟩⟩)
  have hA'inv : ∀ a i j, (A' a)⁻¹ i j ∈ R := fun a i j =>
    Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨a, Or.inr ⟨(i, j), rfl⟩⟩)
  set M := (w.map A).prod with hMdef
  have hMu : IsUnit M := isUnit_list_prod_map A hA w
  have hM'eq : M.map conj = (w.map A').prod := list_prod_map_map (starRingEnd ℂ) A w
  have hint : IsIntegral R (((‖z‖ : ℝ) : ℂ))⁻¹ :=
    isIntegral_norm_inv_of_mem_spectrum hMu (list_prod_inv_mem A hAinv w)
      (by rw [hM'eq]; exact list_prod_inv_mem A' hA'inv w) hz
  have hz0 : z ≠ 0 := ne_zero_of_mem_spectrum hMu hz
  have hαalg : IsAlgebraic ℚ (((‖z‖ : ℝ) : ℂ)) := by
    refine ⟨P.map (Int.castRingHom ℚ), (hPm.map _).ne_zero, ?_⟩
    rw [← algebraMap_int_eq, aeval_map_algebraMap]
    exact hroot
  exact coeff_zero_dvd_pow hPm hPirr (by simpa using hz0) hroot hN.ne'
    (hspec _ hαalg.inv hint)

/-- **The family form.** Let `W s` be words in finitely many invertible complex letters, and let
`x s` be the modulus of an eigenvalue of `A_{W s}` for every `s` in a set `good`. If `x s` is a
root of a monic `Q s ∈ ℤ[X]` irreducible over `ℚ` for `s ∈ good`, and the constant terms of the
`Q s`, `s ∈ good`, have prime divisors outside every finite set, then no such letters exist. -/
theorem no_invertible_family [Finite ι] (A : ι → Matrix n n ℂ) (hA : ∀ a, IsUnit (A a))
    (W : ℕ → List ι) (x : ℕ → ℝ) (Q : ℕ → ℤ[X]) (good : ℕ → Prop)
    (hQm : ∀ s, (Q s).Monic) (hQirr : ∀ s, good s → Irreducible ((Q s).map (Int.castRingHom ℚ)))
    (hroot : ∀ s, good s → aeval (x s) (Q s) = 0)
    (hprimes : ∀ N : ℕ, 0 < N →
      ∃ s, good s ∧ ∃ p : ℕ, p.Prime ∧ (p : ℤ) ∣ (Q s).coeff 0 ∧ ¬ p ∣ N)
    (hW : ∀ s, good s → ∃ z ∈ spectrum ℂ ((W s).map A).prod, ‖z‖ = x s) : False := by
  obtain ⟨N, hN, hmain⟩ := spectral_moduli_norms_divide_pow A hA
  obtain ⟨s, hs, p, hp, hpdvd, hpN⟩ := hprimes N hN
  obtain ⟨z, hz, hzn⟩ := hW s hs
  have hr : aeval ((‖z‖ : ℝ) : ℂ) (Q s) = 0 := by
    rw [hzn, ← Complex.coe_algebraMap, aeval_algebraMap_apply, hroot s hs, map_zero]
  obtain ⟨k, hk⟩ := hmain (W s) z hz (Q s) (hQm s) (hQirr s hs) hr
  have : p ∣ N ^ k := by exact_mod_cast hpdvd.trans hk
  exact hpN (hp.dvd_of_dvd_pow this)

end Matrix
