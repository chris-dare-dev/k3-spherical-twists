import K3Twists.CategoryTheory.Triangulated.ExtComparison.Heart
import K3Twists.RepresentationTheory.Quiver.Preprojective.Basic
import Mathlib.Basic.Complex.Basic

/-!
# The formal wall model and its realization constructor

Let `𝒜` be the abelian category of semistable objects of one phase at a wall of a stability
condition, and `S_i` (`i : I`, finite) the stable objects of that phase. The **formal wall
model** says that the wall objects, the iterated extensions of the `S_i`, are the nilpotent
representations of the double of a half `Q` of the `Ext`-quiver of the `S_i` with the
preprojective relations, with subobject lattices matching subrepresentation lattices and
multiplicities matching dimension vectors.

`Quiver.Preprojective.FormalWallHypotheses` states this as fields over an arbitrary abelian
category:

* the wall objects form a Serre class containing the simple objects `S_i`;
* each wall object `E` has a model, a finite-dimensional nilpotent preprojective representation
  (`Quiver.Preprojective.WallRep`), and an order isomorphism `Subobject E ≃o` its
  subrepresentations, which carries the multiplicities `dim N` of a subobject to the dimension
  vector of the subrepresentation (formality of the `Ext`-algebra, Davison, arXiv:2106.07692,
  Proposition 7.8);
* the **phase windows** (Bayer–Bridgeland, arXiv:1310.8266, Lemma 2.7): for stability conditions
  on the two sides of the wall, the charges `Z_±(S_i)` lie in the upper half-plane, so the phases
  of all subobjects of wall objects lie in one window and are computed from the multiplicities;
* the **seesaw**: crossing the wall reverses the phase order of every two of the `S_i`.

From the fields: the multiplicities of a wall object are the dimension vector of its model
(`FormalWallHypotheses.dim_eq`), every subobject of a wall object is one (`isWall_subobject`), and
on either side of the wall the subobjects of a wall object carry the charge function of the
restricted charge (`FormalWallHypotheses.chargeFunction`), with a unique Harder–Narasimhan
filtration (`FormalWallHypotheses.nonempty_hnFiltration`). So the HN filtration of a wall object
near the wall is the HN filtration of its model, read through the lattice isomorphism.

## The realization constructor

`Quiver.Preprojective.RealizationHypotheses` is a stronger hypothesis of a different shape: a
triangulated functor `F : C ⥤ D` from a source category whose heart `HC` is generated by vertex
simples `S_i`, with a model of each object of `HC`, to a target `D` with heart `HD`, such that

* `F` satisfies the window condition `W_{0,1}` on the vertex simples: bijective on `Hom` and
  `Ext¹`, injective on `Ext²` and surjective on `Ext⁻¹` between them;
* on hearts, `F` is a functor `G : HC ⥤ HD` (`ι_D ∘ G ≅ F ∘ ι_C`) sending the `S_i` to simple
  objects.

`RealizationHypotheses.toFormalWallHypotheses` builds the formal wall model of the target from it.
The proof is window dévissage (`CategoryTheory.Functor.fullyFaithfulOfIsExtWindow` and the
abelian corollary `CategoryTheory.Triangulated.AbelianHeartHypotheses.isSerreClass_image`,
`exists_distinguished_of_mono`): `F` is fully faithful on the extension closure of the vertex
simples, so `G` is fully faithful (`RealizationHypotheses.full_G`, `faithful_G`) and preserves
monomorphisms (`preservesMono_G`), its essential image is a Serre class of `HD`
(`isSerreClass_wall`), and every subobject of `G X` comes from a subobject of `X`
(`exists_of_mono`), so `G` identifies the subobject lattices
(`CategoryTheory.Functor.subobjectOrderIso`). The constructor is the full-faithfulness criterion
of Bondal–Orlov (arXiv:alg-geom/9506012, Theorem 1.1) and Bridgeland (arXiv:math/9809114,
Theorem 1.1) in its finite-length form; it needs no adjoints and no spanning class.

For a finite collection of stable objects of one phase in a 2-Calabi–Yau category, the source is
the thick hull of the simple modules over the Ginzburg dg algebra `G_2(Q)` of the half
`Ext`-quiver (Davison, arXiv:2106.07692; Koszul dual to the `Ext`-algebra of the collection); it
agrees with `D^b(nilp Π_Q)` only off Dynkin components. At a vertex with no neighbour, the
degree-two check needs the compatibility of the Calabi–Yau classes. Mathlib cannot build that
source yet (no dg categories, and no abelian category of quiver representations with its derived
category), so the instance from real objects here is the case of one vertex without loops
(`Preprojective/SingleVertex.lean`): one sphere, the source and target the derived category of
finite-dimensional vector spaces.
-/

noncomputable section

universe u

open CategoryTheory Limits Pretriangulated ZeroObject

namespace Order.ChargeFunction

variable {L L' K : Type*} [Lattice L] [Lattice L'] [Field K] [LinearOrder K]

/-- A charge function pulled back along an order isomorphism. -/
def comapOrderIso (c : ChargeFunction L' K) (φ : L ≃o L') : ChargeFunction L K where
  rk x := c.rk (φ x)
  deg x := c.deg (φ x)
  lex_lt h := c.lex_lt (φ.strictMono h)
  rk_sup_add_inf x y := by
    rw [φ.map_sup, φ.map_inf]
    exact c.rk_sup_add_inf _ _
  deg_sup_add_inf x y := by
    rw [φ.map_sup, φ.map_inf]
    exact c.deg_sup_add_inf _ _

lemma finite_range_comapOrderIso {c : ChargeFunction L' K} (φ : L ≃o L')
    (hfin : (Set.range fun x ↦ (c.rk x, c.deg x)).Finite) :
    (Set.range fun x ↦ ((c.comapOrderIso φ).rk x, (c.comapOrderIso φ).deg x)).Finite :=
  hfin.subset (by rintro _ ⟨x, rfl⟩; exact ⟨φ x, rfl⟩)

end Order.ChargeFunction

namespace Quiver.Preprojective

/-! ### Models of wall objects -/

/-- A model of a wall object: a finite-dimensional nilpotent representation of the double of `Q`
with the preprojective relations, bundled with its vertex spaces. -/
structure WallRep (k : Type u) [Field k] {I : Type*} [Fintype I] [DecidableEq I]
    (Q : I → I → Type*) [∀ i j, Fintype (Q i j)] where
  /-- The vertex spaces. -/
  V : I → Type u
  [addCommGroup : ∀ i, AddCommGroup (V i)]
  [module : ∀ i, Module k (V i)]
  [finiteDimensional : ∀ i, FiniteDimensional k (V i)]
  /-- The representation. -/
  rep : DoubledRep k Q V
  isPreprojective : rep.IsPreprojective
  isNilpotent : rep.IsNilpotent

attribute [instance] WallRep.addCommGroup WallRep.module WallRep.finiteDimensional

/-- The cross product `Re z Im w - Im z Re w`: for `z`, `w` in the upper half-plane it is positive
exactly when `w` has the larger phase. -/
def cross (z w : ℂ) : ℝ :=
  z.re * w.im - z.im * w.re

/-! ### The formal wall model -/

variable (𝒜 : Type*) [Category 𝒜] [Abelian 𝒜] (k : Type u) [Field k] {I : Type*} [Fintype I]
  [DecidableEq I] (Q : I → I → Type*) [∀ i j, Fintype (Q i j)]

/-- **The formal wall model**, over an abelian category `𝒜` (the semistable objects of the phase
of a wall), for the half `Ext`-quiver `Q` of the stable objects `S_i` of that phase.

Sources: formality of the `Ext`-algebra of the `S_i` (Davison, arXiv:2106.07692,
Proposition 7.8) for the models and the lattice isomorphisms; Bayer–Bridgeland
(arXiv:1310.8266, Lemma 2.7 and Remark 2.8) for the phase windows near the wall. -/
structure FormalWallHypotheses where
  /-- The wall objects, the iterated extensions of the `S_i`. -/
  IsWall : ObjectProperty 𝒜
  isSerreClass : IsWall.IsSerreClass
  /-- The stable objects of the wall. -/
  S : I → 𝒜
  simple_S (i : I) : Simple (S i)
  isWall_S (i : I) : IsWall (S i)
  /-- The model of a wall object. -/
  model (E : 𝒜) : IsWall E → WallRep k Q
  /-- Subobjects of a wall object are subrepresentations of its model. -/
  subobjectIso (E : 𝒜) (hE : IsWall E) : Subobject E ≃o (model E hE).rep.subreps
  /-- The multiplicities of the `S_i`. -/
  dim : 𝒜 → I → ℕ
  dim_iso {E E' : 𝒜} : (E ≅ E') → dim E = dim E'
  dim_S (i : I) : dim (S i) = Pi.single i 1
  /-- The lattice isomorphism carries multiplicities to dimension vectors. -/
  dimVec_subobjectIso (E : 𝒜) (hE : IsWall E) (N : Subobject E) :
    DoubledRep.dimVec (subobjectIso E hE N) = dim (N : 𝒜)
  /-- The charges `Z_±(S_i)` on the two sides of the wall. -/
  charge : Bool → I → ℂ
  /-- The phase window: the charges lie in the upper half-plane. -/
  im_charge_pos (s : Bool) (i : I) : 0 < (charge s i).im
  /-- The seesaw: the two sides order the phases of any two `S_i` oppositely. -/
  seesaw (i j : I) :
    cross (charge true i) (charge true j) * cross (charge false i) (charge false j) ≤ 0

namespace FormalWallHypotheses

variable {𝒜 k Q} (W : FormalWallHypotheses 𝒜 k Q)

/-- A subobject of a wall object is a wall object. -/
lemma isWall_subobject {E : 𝒜} (hE : W.IsWall E) (N : Subobject E) : W.IsWall (N : 𝒜) := by
  have := W.isSerreClass
  exact W.IsWall.prop_of_mono N.arrow hE

/-- The multiplicities of a wall object are the dimension vector of its model. -/
lemma dim_eq (E : 𝒜) (hE : W.IsWall E) :
    W.dim E = fun i ↦ Module.finrank k ((W.model E hE).V i) := by
  have h := W.dimVec_subobjectIso E hE ⊤
  rw [OrderIso.map_top, DoubledRep.dimVec_top] at h
  rw [h]
  exact W.dim_iso
    ((Subobject.isoOfEq _ _ (Subobject.top_eq_id E)).trans (Subobject.underlyingIso (𝟙 E))).symm

/-- The charge function of the side `s` of the wall on the subobjects of a wall object `E`:
rank `∑ d_i Im Z_i` and degree `-∑ d_i Re Z_i` at the multiplicities `d` of a subobject. -/
def chargeFunction (s : Bool) (E : 𝒜) (hE : W.IsWall E) : Order.ChargeFunction (Subobject E) ℝ :=
  ((W.model E hE).rep.chargeFunction (fun i ↦ (W.charge s i).im) (fun i ↦ -(W.charge s i).re)
    fun i ↦ Or.inl (W.im_charge_pos s i)).comapOrderIso (W.subobjectIso E hE)

lemma chargeFunction_rk (s : Bool) (E : 𝒜) (hE : W.IsWall E) (N : Subobject E) :
    (W.chargeFunction s E hE).rk N = ∑ i, (W.charge s i).im * W.dim (N : 𝒜) i := by
  simp only [chargeFunction, Order.ChargeFunction.comapOrderIso, DoubledRep.chargeFunction_rk,
    W.dimVec_subobjectIso]

lemma chargeFunction_deg (s : Bool) (E : 𝒜) (hE : W.IsWall E) (N : Subobject E) :
    (W.chargeFunction s E hE).deg N = ∑ i, -(W.charge s i).re * W.dim (N : 𝒜) i := by
  simp only [chargeFunction, Order.ChargeFunction.comapOrderIso, DoubledRep.chargeFunction_deg,
    W.dimVec_subobjectIso]

/-- **Harder–Narasimhan filtrations near the wall.** On either side of the wall, the subobjects of
every wall object have a Harder–Narasimhan filtration for the restricted charge, the image of the
HN filtration of the model; it is unique (`Order.ChargeFunction.HNChain.instSubsingleton`). -/
theorem nonempty_hnFiltration (s : Bool) (E : 𝒜) (hE : W.IsWall E) :
    Nonempty (W.chargeFunction s E hE).HNFiltration :=
  Order.ChargeFunction.nonempty_hnFiltration_of_finite_range _
    (Order.ChargeFunction.finite_range_comapOrderIso _
      ((W.model E hE).rep.finite_range_chargeFunction _))

/-- **The seesaw for two stable objects**: if `S_j` has the larger phase than `S_i` on one side of
the wall, it does not have the larger phase on the other side. -/
theorem cross_nonpos_of_cross_pos {i j : I} (h : 0 < cross (W.charge true i) (W.charge true j)) :
    cross (W.charge false i) (W.charge false j) ≤ 0 := by
  by_contra h'
  exact absurd (W.seesaw i j) (not_le.mpr (mul_pos h (lt_of_not_ge h')))

end FormalWallHypotheses

/-! ### The realization constructor -/

section Realization

variable {C : Type*} [Category C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  {D : Type*} [Category D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  {HC : Type*} [Category HC] [Abelian HC] {HD : Type*} [Category HD] [Abelian HD]

/-- **Realization hypotheses** for a formal wall model: a triangulated functor `F : C ⥤ D` from
a source whose heart `HC` is generated by vertex simples `S_i`, each object of `HC` with a model,
satisfying the window condition `W_{0,1}` on the vertex simples, and inducing a functor
`G : HC ⥤ HD` of hearts that sends the `S_i` to simple objects.

For a finite collection of stable objects of one phase, the source is the thick hull of the
simple modules over the Ginzburg dg algebra of the half `Ext`-quiver (Davison,
arXiv:2106.07692), and the window condition is checked on the `Ext`-algebra of the
collection. -/
structure RealizationHypotheses (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] (ιC : HC ⥤ C)
    (ιD : HD ⥤ D) [ιC.Full] [ιC.Faithful] [ιC.Additive] [ιD.Full] [ιD.Faithful]
    [ιD.Additive] where
  /-- `HC` is a heart of `C`. -/
  heartC : Triangulated.AbelianHeartHypotheses ιC
  /-- `HD` is a heart of `D`. -/
  heartD : Triangulated.AbelianHeartHypotheses ιD
  /-- The vertex simples of the source. -/
  S : I → HC
  /-- The source heart is generated by the vertex simples. -/
  mem_extensionClosure (X : HC) :
    (ObjectProperty.extensionClosure fun Y ↦ ∃ i, Y = ιC.obj (S i)) (ιC.obj X)
  /-- The window condition: bijective on `Hom` and `Ext¹`, injective on `Ext²`, surjective on
  `Ext⁻¹` between vertex simples. -/
  window (i j : I) : F.IsExtWindow 0 1 (ιC.obj (S i)) (ιC.obj (S j))
  /-- The functor on hearts. -/
  G : HC ⥤ HD
  /-- `F` restricts to `G` on hearts. -/
  isoG : ιC ⋙ F ≅ G ⋙ ιD
  /-- The vertex simples are sent to simple objects. -/
  simple_G_S (i : I) : Simple (G.obj (S i))
  /-- The model of a source object. -/
  model (X : HC) : WallRep k Q
  /-- Subobjects in the source heart are subrepresentations of the model. -/
  subobjectIso (X : HC) : Subobject X ≃o (model X).rep.subreps
  /-- The multiplicities of the vertex simples in the source. -/
  dim : HC → I → ℕ
  dim_iso {X X' : HC} : (X ≅ X') → dim X = dim X'
  dim_S (i : I) : dim (S i) = Pi.single i 1
  dimVec_subobjectIso (X : HC) (N : Subobject X) :
    DoubledRep.dimVec (subobjectIso X N) = dim (N : HC)
  /-- The charges `Z_±(G S_i)` on the two sides of the wall. -/
  charge : Bool → I → ℂ
  im_charge_pos (s : Bool) (i : I) : 0 < (charge s i).im
  seesaw (i j : I) :
    cross (charge true i) (charge true j) * cross (charge false i) (charge false j) ≤ 0

namespace RealizationHypotheses

variable {k Q} {F : C ⥤ D} [F.CommShift ℤ] [F.IsTriangulated] {ιC : HC ⥤ C} {ιD : HD ⥤ D}
  [ιC.Full] [ιC.Faithful] [ιC.Additive] [ιD.Full] [ιD.Faithful] [ιD.Additive]
  (R : RealizationHypotheses k Q F ιC ιD)

/-- The vertex simples, as a property of objects of `C`. -/
def vertexFamily : ObjectProperty C :=
  fun Y ↦ ∃ i, Y = ιC.obj (R.S i)

lemma window' : ∀ ⦃X Y : C⦄, R.vertexFamily X → R.vertexFamily Y → F.IsExtWindow 0 1 X Y := by
  rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩
  exact R.window i j

/-- **Window dévissage**: `F` is fully faithful on the extension closure of the vertex simples. -/
def fullyFaithful : (R.vertexFamily.extensionClosure.ι ⋙ F).FullyFaithful :=
  F.fullyFaithfulOfIsExtWindow le_rfl zero_le_one R.window'

lemma simple_image :
    ∀ X, R.vertexFamily X → ∃ A : HD, Simple A ∧ Nonempty (ιD.obj A ≅ F.obj X) := by
  rintro _ ⟨i, rfl⟩
  exact ⟨R.G.obj (R.S i), R.simple_G_S i, ⟨(R.isoG.app (R.S i)).symm⟩⟩

lemma vertexFamily_le_essImage : R.vertexFamily ≤ ιC.essImage := by
  rintro _ ⟨i, rfl⟩
  exact ιC.obj_mem_essImage _

/-- `F` on a morphism of the source heart is `G` conjugated by `isoG`. -/
lemma map_eq_conj {X Y : HC} (f : X ⟶ Y) :
    F.map (ιC.map f) = R.isoG.hom.app X ≫ ιD.map (R.G.map f) ≫ R.isoG.inv.app Y := by
  have h := R.isoG.hom.naturality f
  simp only [Functor.comp_map] at h
  rw [← Category.assoc, ← h, Category.assoc, Iso.hom_inv_id_app, Category.comp_id]

/-- `G` on a morphism of the source heart is `F` conjugated by `isoG`. -/
lemma map_G_eq {X Y : HC} (f : X ⟶ Y) :
    ιD.map (R.G.map f) = R.isoG.inv.app X ≫ F.map (ιC.map f) ≫ R.isoG.hom.app Y := by
  rw [R.map_eq_conj f]
  simp

/-- The object `ιC X` of the extension closure, as an object of its full subcategory. -/
abbrev closureObj (X : HC) : R.vertexFamily.extensionClosure.FullSubcategory :=
  ⟨ιC.obj X, R.mem_extensionClosure X⟩

/-- **`G` is faithful.** -/
theorem faithful_G : R.G.Faithful where
  map_injective {X Y} f g h := by
    have h' : (R.vertexFamily.extensionClosure.ι ⋙ F).map
        (ObjectProperty.homMk (ιC.map f) : R.closureObj X ⟶ R.closureObj Y) =
        (R.vertexFamily.extensionClosure.ι ⋙ F).map
          (ObjectProperty.homMk (ιC.map g) : R.closureObj X ⟶ R.closureObj Y) := by
      simp only [Functor.comp_map, ObjectProperty.ι_map, ObjectProperty.homMk_hom]
      rw [R.map_eq_conj f, R.map_eq_conj g, h]
    have := congrArg (R.vertexFamily.extensionClosure.ι).map (R.fullyFaithful.map_injective h')
    simp only [ObjectProperty.ι_map, ObjectProperty.homMk_hom] at this
    exact ιC.map_injective this

/-- **`G` is full.** -/
theorem full_G : R.G.Full where
  map_surjective {X Y} u := by
    let w := R.fullyFaithful.preimage (X := R.closureObj X) (Y := R.closureObj Y)
      (R.isoG.hom.app X ≫ ιD.map u ≫ R.isoG.inv.app Y)
    have hw : F.map w.hom = R.isoG.hom.app X ≫ ιD.map u ≫ R.isoG.inv.app Y :=
      R.fullyFaithful.map_preimage (X := R.closureObj X) (Y := R.closureObj Y) _
    refine ⟨ιC.preimage w.hom, ιD.map_injective ?_⟩
    have e := R.map_eq_conj (ιC.preimage w.hom)
    rw [ιC.map_preimage, hw, cancel_epi, cancel_mono] at e
    exact e.symm

/-- **`G` preserves monomorphisms**: the image of the first map of a short exact sequence is the
first map of a short exact sequence. -/
theorem preservesMono_G : R.G.PreservesMonomorphisms where
  preserves {X Y} g _ := by
    have hS : (ShortComplex.mk g (cokernel.π g) (cokernel.condition g)).ShortExact :=
      .mk' (ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel g)) inferInstance
        inferInstance
    obtain ⟨δ, hδ⟩ := R.heartC.distinguished_of_shortExact _ hS
    have hmono := R.heartD.mono_of_distinguished (F := F) (P := R.vertexFamily) R.simple_image hδ
      (R.mem_extensionClosure _) (R.isoG.app X).symm (R.isoG.app Y).symm
    have key : ιD.preimage ((R.isoG.app X).symm.hom ≫
        F.map (Triangle.mk (ιC.map g) (ιC.map (cokernel.π g)) δ).mor₁ ≫
          (R.isoG.app Y).symm.inv) = R.G.map g := by
      apply ιD.map_injective
      rw [Functor.map_preimage]
      simp [R.map_eq_conj g]
    rw [key] at hmono
    exact hmono

/-- **Every subobject of `G X` comes from a subobject of `X`.** -/
theorem exists_of_mono (X : HC) ⦃Y : HD⦄ (f : Y ⟶ R.G.obj X) [Mono f] :
    ∃ (Z : HC) (g : Z ⟶ X) (_ : Mono g) (e : R.G.obj Z ≅ Y), e.hom ≫ f = R.G.map g := by
  obtain ⟨X₁, X₃, f', g', δ, hT, h₁, h₃, e₁, he₁⟩ :=
    R.heartD.exists_distinguished_of_mono le_rfl le_rfl R.window' R.simple_image
      (R.mem_extensionClosure X) (R.isoG.app X).symm f
  obtain ⟨Z, ⟨eZ⟩⟩ := R.heartC.extensionClosure_le_essImage R.vertexFamily_le_essImage _ h₁
  obtain ⟨Z₃, ⟨eZ₃⟩⟩ := R.heartC.extensionClosure_le_essImage R.vertexFamily_le_essImage _ h₃
  have hSES := R.heartC.shortExact_of_iso hT eZ (Iso.refl (ιC.obj X)) eZ₃
  have hmono : Mono (ιC.preimage (eZ.hom ≫ f' ≫ (Iso.refl (ιC.obj X)).inv)) := hSES.mono_f
  refine ⟨Z, _, hmono, ιD.preimageIso ((R.isoG.app Z).symm ≪≫ F.mapIso eZ ≪≫ e₁.symm),
    ιD.map_injective ?_⟩
  have he₁' : ιD.map f = e₁.hom ≫ F.map f' ≫ R.isoG.hom.app X := by
    rw [← Category.assoc, he₁]
    simp
  rw [ιD.map_comp, Functor.preimageIso_hom, Functor.map_preimage, he₁', R.map_G_eq,
    Functor.map_preimage]
  simp

/-- The essential image of `G` is a Serre class of `HD`: the abelian corollary of window
dévissage. -/
theorem isSerreClass_wall :
    ObjectProperty.IsSerreClass fun E : HD ↦ ∃ X : HC, Nonempty (R.G.obj X ≅ E) := by
  have h := R.heartD.isSerreClass_image (by norm_num : (0 : ℤ) ≤ 2) le_rfl R.window' R.simple_image
  have key : (fun E : HD ↦ ∃ X : HC, Nonempty (R.G.obj X ≅ E)) =
      fun A : HD ↦ ∃ X, R.vertexFamily.extensionClosure X ∧ Nonempty (F.obj X ≅ ιD.obj A) := by
    funext A
    apply propext
    constructor
    · rintro ⟨X, ⟨e⟩⟩
      exact ⟨ιC.obj X, R.mem_extensionClosure X, ⟨R.isoG.app X ≪≫ ιD.mapIso e⟩⟩
    · rintro ⟨X', hX', ⟨e⟩⟩
      obtain ⟨Z, ⟨eZ⟩⟩ := R.heartC.extensionClosure_le_essImage R.vertexFamily_le_essImage _ hX'
      exact ⟨Z, ⟨ιD.preimageIso ((R.isoG.app Z).symm ≪≫ F.mapIso eZ ≪≫ e)⟩⟩
  rw [key]
  exact h

/-- The subobjects of `X` and of `G X` agree. -/
def subobjectIsoG (X : HC) : Subobject X ≃o Subobject (R.G.obj X) :=
  have := R.preservesMono_G
  have := R.full_G
  have := R.faithful_G
  R.G.subobjectOrderIso X (R.exists_of_mono X)

/-- The underlying object of the image of a subobject is `G` of it. -/
def underlyingSubobjectIsoG {X : HC} (N : Subobject X) :
    ((R.subobjectIsoG X N : Subobject (R.G.obj X)) : HD) ≅ R.G.obj (N : HC) :=
  have := R.preservesMono_G
  R.G.underlyingMapSubobjectIso N

/-- `G` reflects isomorphisms of objects. -/
def preimageIsoG {X X' : HC} (e : R.G.obj X ≅ R.G.obj X') : X ≅ X' :=
  have := R.full_G
  have := R.faithful_G
  R.G.preimageIso e

/-- The multiplicities of the target: those of a preimage under `G`. -/
def dimD (E : HD) : I → ℕ :=
  open Classical in
  if h : ∃ X : HC, Nonempty (R.G.obj X ≅ E) then R.dim h.choose else 0

lemma dimD_eq {E : HD} {X : HC} (e : R.G.obj X ≅ E) : R.dimD E = R.dim X := by
  have h : ∃ X : HC, Nonempty (R.G.obj X ≅ E) := ⟨X, ⟨e⟩⟩
  rw [dimD, dite_eq_left h]
  exact R.dim_iso (R.preimageIsoG (h.choose_spec.some ≪≫ e.symm))

/-- **The realization constructor**: realization hypotheses give the formal wall model of the
target heart, with the wall objects the essential image of `G` and the models those of the
source. -/
def toFormalWallHypotheses : FormalWallHypotheses HD k Q where
  IsWall E := ∃ X : HC, Nonempty (R.G.obj X ≅ E)
  isSerreClass := R.isSerreClass_wall
  S i := R.G.obj (R.S i)
  simple_S := R.simple_G_S
  isWall_S i := ⟨R.S i, ⟨Iso.refl _⟩⟩
  model E hE := R.model hE.choose
  subobjectIso E hE := (Subobject.mapIsoToOrderIso hE.choose_spec.some).symm.trans
    ((R.subobjectIsoG hE.choose).symm.trans (R.subobjectIso hE.choose))
  dim := R.dimD
  dim_iso {E E'} e := by
    by_cases h : ∃ X : HC, Nonempty (R.G.obj X ≅ E)
    · rw [R.dimD_eq h.choose_spec.some, R.dimD_eq (h.choose_spec.some ≪≫ e)]
    · have h' : ¬∃ X : HC, Nonempty (R.G.obj X ≅ E') := fun ⟨X, ⟨e'⟩⟩ ↦ h ⟨X, ⟨e' ≪≫ e.symm⟩⟩
      rw [dimD, dimD, dite_eq_right h, dite_eq_right h']
  dim_S i := by rw [R.dimD_eq (Iso.refl _), R.dim_S]
  dimVec_subobjectIso E hE N := by
    rw [OrderIso.trans_apply, OrderIso.trans_apply, R.dimVec_subobjectIso]
    symm
    refine R.dimD_eq ((R.underlyingSubobjectIsoG _).symm ≪≫ ?_)
    rw [OrderIso.apply_symm_apply]
    exact Subobject.mapObjUnderlyingIso _ _
  charge := R.charge
  im_charge_pos := R.im_charge_pos
  seesaw := R.seesaw

end RealizationHypotheses

end Realization

end Quiver.Preprojective
